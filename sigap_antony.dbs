		<view name="vw_carga_masiva_comisicion_de_servicio" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS SELECT n_fila,
    _apellido_materno,
    _apellido_paterno,
    _codigo_sede,
    _codigo_tipo_documento,
    _fecha_fin_acceso,
    _fecha_inicio_acceso,
    _hora_fin_acceso,
    _hora_inicio_acceso,
    _motivo_solicitud,
    _nombres,
    _nro,
    _numero_documento
   FROM crosstab('select n_fila,c_clave,c_valor from sigap.DET_CARGA_ARCHIVO where n_carga_archivo=4 and n_activo = 1 group by n_fila, c_clave, c_valor order by 1'::text, 'select distinct c_clave from sigap.DET_CARGA_ARCHIVO where n_carga_archivo=4 and n_activo = 1 order by 1'::text) newtable(n_fila character varying, _apellido_materno text, _apellido_paterno text, _codigo_sede text, _codigo_tipo_documento text, _fecha_fin_acceso text, _fecha_inicio_acceso text, _hora_fin_acceso text, _hora_inicio_acceso text, _motivo_solicitud text, _nombres text, _nro text, _numero_documento text)]]></view_script>
			<column name="n_fila" type="varchar" />
			<column name="_apellido_materno" type="text" />
			<column name="_apellido_paterno" type="text" />
			<column name="_codigo_sede" type="text" />
			<column name="_codigo_tipo_documento" type="text" />
			<column name="_fecha_fin_acceso" type="text" />
			<column name="_fecha_inicio_acceso" type="text" />
			<column name="_hora_fin_acceso" type="text" />
			<column name="_hora_inicio_acceso" type="text" />
			<column name="_motivo_solicitud" type="text" />
			<column name="_nombres" type="text" />
			<column name="_nro" type="text" />
			<column name="_numero_documento" type="text" />
		</view>
		<view name="vw_carga_masiva_jornada_extendida" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS SELECT n_fila,
    _apellido_materno,
    _apellido_paterno,
    _codigo_sede,
    _codigo_tipo_documento,
    _fecha_fin_acceso,
    _fecha_inicio_acceso,
    _hora_fin_acceso,
    _hora_inicio_acceso,
    _motivo_solicitud,
    _nombres,
    _nro,
    _numero_documento
   FROM crosstab('select n_fila,c_clave,c_valor from sigap.DET_CARGA_ARCHIVO where n_carga_archivo=19 and n_activo = 1 group by n_fila, c_clave, c_valor order by 1'::text, 'select distinct c_clave from sigap.DET_CARGA_ARCHIVO where n_carga_archivo=19 and n_activo = 1 order by 1'::text) newtable(n_fila character varying, _apellido_materno text, _apellido_paterno text, _codigo_sede text, _codigo_tipo_documento text, _fecha_fin_acceso text, _fecha_inicio_acceso text, _hora_fin_acceso text, _hora_inicio_acceso text, _motivo_solicitud text, _nombres text, _nro text, _numero_documento text)]]></view_script>
			<column name="n_fila" type="varchar" />
			<column name="_apellido_materno" type="text" />
