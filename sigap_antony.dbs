		<script name="SQL_Editor" id="bc79169c-1475-465d-a216-7b8f686debf0" language="Groovy" >
			<string><![CDATA[// -----------------------------
// Generador automático de diccionario de datos (DbSchema - Groovy)
// SOLO CAMPOS de cada tabla del esquema
// -----------------------------

// --- CONFIG ----
def schema = 'sigap_anthony'   // <-- cambia si hace falta
def outputDir = 'C:/Users/avalencia/Desktop/diccionario'
def outputFile = "${outputDir}/diccionario_sigap.html"
// -----------------

new File(outputDir).mkdirs()

out.println("Inicio: generar diccionario de CAMPOS para schema='${schema}' en: ${outputFile}")

// --- Lista de tablas ---
def listTablesSql = """
SELECT table_name
FROM information_schema.tables
WHERE table_schema = '${schema}'
  AND table_type = 'BASE TABLE'
ORDER BY table_name
"""

def tableNames = sql.rows(listTablesSql).collect{ it.table_name }
out.println("Tablas detectadas: ${tableNames.size()}")

// --- SQL de CAMPOS (con placeholders {schema} y {table}) ---

// -----------------------------
// Función para obtener TABLAS y sus comentarios
// -----------------------------
def obtenerTablasConComentarios(schema) {
    def sqlTablas = """
    SELECT 
        n.nspname AS esquema,
        c.relname AS tabla,
        obj_description(c.oid) AS comentario
    FROM 
        pg_class c
    JOIN 
        pg_namespace n ON n.oid = c.relnamespace
    WHERE 
        c.relkind = 'r'  -- solo tablas normales
        AND n.nspname = '${schema}'
    ORDER BY 
        esquema, tabla;
    """
    
    def resultado = [:]  // mapa: [tabla -> comentario]
    try {
        def rows = sql.rows(sqlTablas)
        rows.each { r ->
            resultado[r.tabla] = r.comentario ?: ''
        }
    } catch (Exception e) {
        out.println("Error al obtener comentarios de tablas: ${e.message}")
    }
    return resultado
}

def camposTemplate = '''
SELECT
    lower(c.COLUMN_NAME) AS nombre_columna,
    CASE
        WHEN c.udt_name = 'date' THEN 'date'
        WHEN c.udt_name = 'timestamp' THEN 'timestamp'
        WHEN c.udt_name = 'int8' THEN 'bigint'
        WHEN c.udt_name = 'int2' THEN 'smallint'
        WHEN c.udt_name = 'text' THEN 'text'
        WHEN c.udt_name = 'numeric' THEN 'numeric'
        WHEN c.udt_name = 'jsonb' THEN 'jsonb'
        WHEN c.udt_name IN ('bpchar', 'varchar') THEN 'varchar(' || COALESCE(c.character_maximum_length, 255)::text || ')'
        ELSE
            CASE
                WHEN c.udt_name = 'int4' THEN 'integer'
                WHEN c.character_maximum_length IS NOT NULL THEN c.udt_name || ' (' || c.character_maximum_length || ')'
                ELSE c.udt_name
            END
    END AS TIPO,
    CASE WHEN C.is_nullable = 'YES' THEN 'SI' ELSE 'NO' END AS Permite_Nulos,
    pk_info.is_pk AS PK,
    fk_info.is_fk AS FK,
    pgd.description AS descripcion_columna,
    CASE
        WHEN C.DATA_TYPE = 'text' THEN 'Cadena tipo text'
        WHEN C.DATA_TYPE = 'numeric' THEN 'Número decimal'
        WHEN C.DATA_TYPE = 'jsonb' THEN 'Representación binaria de los datos JSON'
        WHEN (C.DATA_TYPE = 'integer' OR C.DATA_TYPE = 'smallint' OR C.DATA_TYPE = 'bigint') THEN 'Número entero positivo'
        ELSE
            CASE
                WHEN (C.DATA_TYPE = 'date' OR C.DATA_TYPE = 'timestamp without time zone' OR C.DATA_TYPE = 'timestamp with time zone') THEN 'dd/mm/aaaa hh:mm:ss'
                WHEN C.character_maximum_length IS NOT NULL THEN 'Cadena de hasta ' || c.character_maximum_length || ' caracteres'
                ELSE 'Valor específico del tipo de dato'
            END
    END AS Valores_permitidos
FROM information_schema.columns c
LEFT JOIN pg_catalog.pg_description pgd ON (
    pgd.objoid = (
        SELECT c_table.oid
        FROM pg_catalog.pg_class c_table
        WHERE c_table.relname = c.table_name
        AND c_table.relnamespace = (
            SELECT n.oid
            FROM pg_catalog.pg_namespace n
            WHERE n.nspname = c.table_schema
        )
    )
    AND pgd.objsubid = c.ordinal_position
)
LEFT JOIN (
    SELECT
        kcu.table_schema,
        kcu.table_name,
        kcu.column_name,
        'SI' AS is_pk
    FROM information_schema.table_constraints tc
    JOIN information_schema.key_column_usage kcu
        ON tc.constraint_name = kcu.constraint_name
        AND tc.table_schema = kcu.table_schema
        AND tc.table_name = kcu.table_name
    WHERE tc.constraint_type = 'PRIMARY KEY'
) AS pk_info
ON c.table_schema = pk_info.table_schema
AND c.table_name = pk_info.table_name
AND c.column_name = pk_info.column_name
LEFT JOIN (
    SELECT
        kcu.table_schema,
        kcu.table_name,
        kcu.column_name,
        'SI' AS is_fk
    FROM information_schema.table_constraints tc
    JOIN information_schema.key_column_usage kcu
        ON tc.constraint_name = kcu.constraint_name
        AND tc.table_schema = kcu.table_schema
        AND tc.table_name = kcu.table_name
    WHERE tc.constraint_type = 'FOREIGN KEY'
) AS fk_info
ON c.table_schema = fk_info.table_schema
AND c.table_name = fk_info.table_name
AND c.column_name = fk_info.column_name
WHERE c.table_schema = '{schema}'
AND c.table_name = '{table}'
ORDER BY
    CASE
        WHEN pk_info.is_pk IS NOT NULL THEN 1
        WHEN fk_info.is_fk IS NOT NULL THEN 2
        WHEN lower(c.COLUMN_NAME) = 'n_activo' THEN 100
        WHEN lower(c.COLUMN_NAME) = 'c_aud_usuario_creacion' THEN 101
        WHEN lower(c.COLUMN_NAME) = 'd_aud_fecha_creacion' THEN 102
        WHEN lower(c.COLUMN_NAME) = 'c_aud_usuario_modificacion' THEN 103
        WHEN lower(c.COLUMN_NAME) = 'd_aud_fecha_modificacion' THEN 104
        ELSE 3
    END,
    c.ordinal_position;
'''

// --- Abrir archivo HTML y escribir contenido ---
new File(outputFile).withWriter('UTF-8') { writer ->
    writer.println("<html><head><meta charset='utf-8'><style>body{font-family:Arial,Helvetica,sans-serif}table{border-collapse:collapse;width:100%}th,td{border:1px solid #999;padding:6px;text-align:left}th{background:#f2f2f2}</style></head><body>")
    writer.println("<h1>DICCIONARIO DE DATOS</h1>")
    writer.println("<h2>Descripción de Tablas</h2>")
    def tablaComentarios = obtenerTablasConComentarios(schema)
    
    if (!tablaComentarios.isEmpty()) {
        writer.println("<table>")
        writer.println("<tr><th colspan='3' align='center'>Entidades</th></tr>")
        writer.println("<tr><th>N°</th><th>Tabla</th><th>Descripción</th></tr>")    
        def i = 1
        tablaComentarios.each { tName, desc ->
            writer.println("<tr><td>${i}</td><td>${tName}</td><td>${desc}</td></tr>")
            i++
        }
        writer.println("</table>")
    } else {
        writer.println("<p><em>No se encontraron comentarios de tablas en el esquema.</em></p>")
    }

    writer.println("<h2>Descripción de los Atributos</h2>")    

    tableNames.eachWithIndex { tName, idx ->
        writer.println("<h3>Atributos de la tabla: ${tName}</h3>")

        // Ejecutar la consulta CAMPOS para esta tabla
        def q = camposTemplate.replace('{schema}', schema).replace('{table}', tName)
        def rows = []
        try {
            rows = sql.rows(q)
        } catch (Exception e) {
            out.println("Error ejecutando CAMPOS para tabla ${tName}: ${e.message}")
            writer.println("<p style='color:crimson'>Error al obtener columnas: ${e.message}</p>")
            return
        }

        if (!rows || rows.size() == 0) {
            writer.println("<p><em>No se encontraron columnas</em></p>")
        } else {
            writer.println("<table>")
            writer.println("<tr><th>N°</th><th>Columna</th><th>Tipo</th><th>Permite Nulos</th><th>PK</th><th>FK</th><th>Descripción</th><th>Valores permitidos</th></tr>")
            def j=1
            rows.each { r ->
                def col = r.nombre_columna ?: ''
                def tipo = r.tipo ?: r.TIPO ?: ''
                def nulos = r.permite_nulos ?: r.Permite_Nulos ?: ''
                def pk = r.pk ?: r.PK ?: ''
                def fk = r.fk ?: r.FK ?: ''
                def desc = r.descripcion_columna ?: ''
                def vals = r.valores_permitidos ?: r.Valores_permitidos ?: ''
                writer.println("<tr><td>${j}</td><td>${col}</td><td>${tipo}</td><td>${nulos}</td><td>${pk}</td><td>${fk}</td><td>${desc}</td><td>${vals}</td></tr>")
                j++
            }
            writer.println("</table>")
        }
    }
    writer.println("</body></html>")
}

out.println("HTML generado en: ${outputFile}")
out.println("Fin del script.")
]]></string>
		</script>
