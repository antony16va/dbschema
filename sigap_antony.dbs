		<table name="prueba" generator_rows="50" generator_order="0" spec="" >
			<column name="n_prueba_pk" type="integer" length="32" mandatory="y" />
			<column name="c_nombre" prior="nombre" type="varchar" length="100" regexp="list:file=NamesFirst.txt" regexp_nulls="10" />
			<column name="c_apellido" prior="apellido" type="varchar" length="100" regexp="list:file=NamesLast.txt" />
			<column name="n_edad" prior="edad" type="integer" length="32" regexp="int:from=0;to=99;" />
			<column name="c_correo" prior="correo" type="varchar" length="150" regexp="[a-z]{4,8}([0-9]{0,3}|.[a-z]{4,10})@example.com" />
			<column name="c_telefono" prior="telefono" type="varchar" length="20" regexp="[0-9]{3}(-)[0-9]{3}(-)[0-9]{4}" regexp_nulls="10" />
			<column name="c_direccion" prior="direccion" type="varchar" length="200" regexp="((APT|Appartment) [1-9][0-9]{0,2})|(Suite [1-9][0-9]{0,3})|((1st|2nd|3rd|[4-9]th|[1-9]{2,3}th) Floor)|((Sales|Customer|After Sales|Pre Sales|Post Sales) (Group|Department))|((Lincoln|Washington|Jefferson|Roosevelt|Hamilton|Franklin|Marshall|Edison|Wilson|Madison|Roosevelt|Truman|Einstein|Anthony|Sanger|Foster) Building)" />
			<column name="c_ciudad" prior="ciudad" type="varchar" length="100" regexp="list:file=Country.txt" />
			<column name="n_salario" prior="salario" type="decimal" length="10" decimal="2" regexp="double:from=0;to=10000;format=########.##;" />
			<column name="d_fecha_registro" prior="fecha_registro" type="date" length="0" regexp="date:from=&#039;01.01.2023&#039;;to=&#039;01.01.2025&#039;;" />
			<column name="checksum" type="serial" />
			<index name="prueba_pkey" unique="PRIMARY_KEY" >
				<column name="n_prueba_pk" />
			</index>
		</table>
