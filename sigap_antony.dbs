		<procedure name="sp_cargar_comision_de_servicio" id="c365cd51-8f08-44f2-b970-2fc977a0697f" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_comision_de_servicio(IN pi_esquema text, IN pi_solicitud integer, IN pi_aud_usuario_creacion text, IN pi_id_coordinador integer, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 08/10/2024 */
	/* Modificado por:     */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_personal_servicio integer;
	v_personal_contrato_com integer;
	v_det_personal_contrato_com integer;
	v_tab_solicitud_evaluacion_com integer;
	existing_personal integer;
	v_existe_det_solicitud integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE N_SOLICITUD = pi_solicitud AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_comisicion_de_servicio;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_comisicion_de_servicio AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_comisicion_de_servicio  
		LOOP
			/*
		    CREATE TEMP TABLE temp_exact_conflicts_com_1 AS
		    SELECT 
		        a1.numero_documento,
		        a1.c_estado_solicitud_detalle,
		        a1.fecha_inicio_acceso,
		        a1.fecha_fin_acceso,
		        a1.hora_ingreso,
		        a1.hora_salida,
				a1.sede,
				a1.tipo_documento
		        --a1.numero_contrato
		    FROM (
		        SELECT 
		            --tc.c_numero_contrato AS numero_contrato,
		            dsp.d_fecha_inicio_acceso::DATE AS fecha_inicio_acceso,
		            dsp.d_fecha_fin_acceso::DATE AS fecha_fin_acceso,
		            tps.c_numero_documento AS numero_documento,
					tps.n_tipo_documento as tipo_documento,
		            dce.c_nombre AS c_estado_solicitud_detalle,
		            dsp.d_hora_ingreso hora_ingreso,
		            dsp.d_hora_salida hora_salida,
					dsp.n_sede sede
		        --FROM tab_contrato tc
		        --INNER JOIN 
		        from det_solicitud_contrato dsc --ON dsc.n_contrato = tc.n_contrato_pk 
		        INNER JOIN cab_solicitud cs ON cs.n_solicitud_pk = dsc.n_solicitud AND cs.n_tipo_solicitud = 3 and cs.n_activo=1
		        INNER JOIN tab_solicitud_evaluacion tse ON tse.n_solicitud = cs.n_solicitud_pk 
		            AND tse.n_estado_solicitud IN (1, 2, 3)
		        INNER JOIN det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1
		        INNER JOIN det_solicitud_personal dsp ON dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk 
		            AND dsp.n_estado_solicitud_detalle IN (1, 2) 
		            AND dsp.n_activo = 1
		        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = dsp.n_estado_solicitud_detalle 
		            AND dce.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' and dce.n_activo=1
		        INNER JOIN tab_personal_servicio tps ON tps.n_personal_servicio_pk = dpc.n_personal_servicio and tps.n_activo=1
		    ) a1
		    WHERE UPPER(a1.numero_documento) = UPPER(rec._numero_documento)
			  and a1.tipo_documento::integer =  rec._codigo_tipo_documento::integer
		      AND a1.hora_ingreso = rec._hora_inicio_acceso::TIME
		      AND a1.hora_salida = rec._hora_fin_acceso::TIME
			  AND a1.sede = rec._codigo_sede::integer
		      AND a1.fecha_inicio_acceso::DATE = TO_DATE(rec._fecha_inicio_acceso, 'DD/MM/YYYY')
			  AND a1.fecha_fin_acceso::DATE = TO_DATE(rec._fecha_fin_acceso, 'DD/MM/YYYY');
		    IF EXISTS (SELECT 1 FROM temp_exact_conflicts_com_1) THEN
		        FOR conflict_records IN SELECT * FROM temp_exact_conflicts_com_1 LOOP
		            conflict_list := conflict_list || E'\n- Documento: ' || conflict_records.numero_documento
													 || ', Tipo Documento: ' || conflict_records.tipo_documento 
		                                             || ', Hora Inicio: ' || conflict_records.hora_ingreso
		                                             || ', Hora Fin: ' || conflict_records.hora_salida
													 || ', Sede: ' || conflict_records.sede
		                                             || ', Estado: ' || conflict_records.c_estado_solicitud_detalle
		                                             || ', Fecha Inicio: ' || conflict_records.fecha_inicio_acceso
		                                             || ', Fecha Fin: ' || conflict_records.fecha_fin_acceso;
		        END LOOP;
		        RAISE EXCEPTION 'Error: La persona ingresada ya cuenta con una comisión de servicio válido';
		    ELSE
		        RAISE NOTICE 'No se encontraron conflictos. Continuando con la operación.';
		    END IF;]]></string>
		</procedure>
		<procedure name="sp_cargar_jornada_extendida" id="b9a35856-ae50-479e-a3ad-3643af07d0dd" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_jornada_extendida(IN pi_esquema text, IN pi_solicitud integer, IN pi_aud_usuario_creacion text, IN pi_id_coordinador integer, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 08/10/2024 */
	/* Modificado por:     */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_personal_servicio_je integer;
	v_personal_contrato_je integer;
	v_det_personal_contrato_je integer;
	v_tab_solicitud_evaluacion_je integer;
	existing_personal_je integer;
	v_existe_det_solicitud integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE N_SOLICITUD = pi_solicitud AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_jornada_extendida;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_jornada_extendida AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_jornada_extendida  
		LOOP
		/*
		    CREATE TEMP TABLE temp_exact_conflicts_je_1 AS
		    SELECT 
		        a1.numero_documento,
		        a1.c_estado_solicitud_detalle,
		        a1.fecha_inicio_acceso,
		        a1.fecha_fin_acceso,
		        a1.hora_ingreso,
		        a1.hora_salida,
				a1.sede,
				a1.tipo_documento
		        --a1.numero_contrato
		    FROM (
		        SELECT 
		            --tc.c_numero_contrato AS numero_contrato,
		            dsp.d_fecha_inicio_acceso::DATE AS fecha_inicio_acceso,
		            dsp.d_fecha_fin_acceso::DATE AS fecha_fin_acceso,
		            tps.c_numero_documento AS numero_documento,
					tps.n_tipo_documento as tipo_documento,
		            dce.c_nombre AS c_estado_solicitud_detalle,
		            dsp.d_hora_ingreso hora_ingreso,
		            dsp.d_hora_salida hora_salida,
					dsp.n_sede sede
		        --FROM tab_contrato tc
		        --INNER JOIN 
		        from det_solicitud_contrato dsc --ON dsc.n_contrato = tc.n_contrato_pk 
		        INNER JOIN cab_solicitud cs ON cs.n_solicitud_pk = dsc.n_solicitud AND cs.n_tipo_solicitud = 4
		        INNER JOIN tab_solicitud_evaluacion tse ON tse.n_solicitud = cs.n_solicitud_pk 
		            AND tse.n_estado_solicitud IN (1, 2, 3)
		        INNER JOIN det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk 
		        INNER JOIN det_solicitud_personal dsp ON dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk 
		            AND dsp.n_estado_solicitud_detalle IN (1, 2) 
		            AND dsp.n_activo = 1
		        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = dsp.n_estado_solicitud_detalle 
		            AND dce.c_columna = 'N_ESTADO_SOLICITUD_DETALLE'
		        INNER JOIN tab_personal_servicio tps ON tps.n_personal_servicio_pk = dpc.n_personal_servicio and tps.n_activo=1
		    ) a1
		    WHERE UPPER(a1.numero_documento) = UPPER(rec._numero_documento)
			  and a1.tipo_documento::integer =  rec._codigo_tipo_documento::integer
		      AND a1.hora_ingreso = rec._hora_inicio_acceso::TIME
		      AND a1.hora_salida = rec._hora_fin_acceso::TIME
			  AND a1.sede = rec._codigo_sede::integer
		      AND a1.fecha_inicio_acceso::DATE = TO_DATE(rec._fecha_inicio_acceso, 'DD/MM/YYYY')
			  AND a1.fecha_fin_acceso::DATE = TO_DATE(rec._fecha_fin_acceso, 'DD/MM/YYYY');
		    IF EXISTS (SELECT 1 FROM temp_exact_conflicts_je_1) THEN
		        FOR conflict_records IN SELECT * FROM temp_exact_conflicts_je_1 LOOP
		            conflict_list := conflict_list || E'\n- Documento: ' || conflict_records.numero_documento 
													 || ', Tipo Documento: ' || conflict_records.tipo_documento 
		                                             || ', Hora Inicio: ' || conflict_records.hora_ingreso
		                                             || ', Hora Fin: ' || conflict_records.hora_salida
													 || ', Sede: ' || conflict_records.sede
		                                             || ', Estado: ' || conflict_records.c_estado_solicitud_detalle
		                                             || ', Fecha Inicio: ' || conflict_records.fecha_inicio_acceso
		                                             || ', Fecha Fin: ' || conflict_records.fecha_fin_acceso;
		        END LOOP;
		        RAISE EXCEPTION 'Error: La persona ingresada ya cuenta con una jornada extendida válido';
		    ELSE
		        RAISE NOTICE 'No se encontraron conflictos. Continuando con la operación.';
		    END IF;]]></string>
		</procedure>
		<procedure name="sp_cargar_personal" id="b90eca64-9fd8-45fb-b10a-db0c921cd897" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_personal(IN pi_esquema text, IN pi_solicitud integer, IN pi_aud_usuario_creacion text, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 08/10/2024 */
	/* Modificado por:    */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_n_contrato_per integer;
	v_personal_servicio_per integer;
	v_personal_contrato_per integer;
	v_det_personal_contrato_per integer;
	v_tab_solicitud_evaluacion_per integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	existing_contrato_per integer;
	existing_personal_per integer;
	contrato_rec RECORD;
	persona_rec RECORD;
	--condicion_a_verificar INTEGER;
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE N_SOLICITUD = pi_solicitud AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_personal;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_personal AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_personal  
		LOOP
	        SELECT n_personal_servicio_pk INTO existing_personal_per
	        FROM tab_personal_servicio
	        WHERE UPPER(c_numero_documento) = UPPER(rec._numero_documento::text) 
					and n_tipo_documento::integer  = rec._codigo_tipo_documento::integer  
			and n_activo = 1;
			/*
	        SELECT n_contrato_pk INTO existing_contrato_per
	        FROM tab_contrato
	        WHERE UPPER(c_numero_contrato) = UPPER(rec._numero_contrato::text) and n_activo = 1;
			*/
 			SELECT n_contrato_pk INTO existing_contrato_per
	        FROM tab_contrato
	        WHERE n_activo = 1 AND (rec._numero_contrato IS NOT NULL AND rec._numero_contrato <> '' 
			       AND UPPER(c_numero_contrato) = UPPER(rec._numero_contrato::text))
	        LIMIT 1;	
	    	IF existing_contrato_per IS NULL AND existing_personal_per IS NULL THEN
	            INSERT INTO tab_contrato (n_contrato_pk,d_fecha_inicio_contrato,d_fecha_fin_contrato,n_tipo_contrato,n_tipo_proceso_contrato,
				--c_motivo_proceso_contrato,
				n_proceso_electoral, 
				c_numero_contrato, c_nombre_contrato, n_unidad_organica, n_sede, c_oficina, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_contrato_pk'), to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), rec._tipo_modalidad_contrato::integer,rec._tipo_proceso_contrato::integer,
				NULLIF(rec._codigo_proceso_electoral, '')::integer,
				--UPPER(rec._numero_contrato::text), 
				NULLIF(UPPER(rec._numero_contrato::text), ''), 
				UPPER(rec._nombre_contrato::text),
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            rec._codigo_sede::integer, rec._oficina::text,pi_aud_usuario_creacion::text)
	            RETURNING n_contrato_pk INTO v_n_contrato_per; 
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), v_n_contrato_per, pi_solicitud, pi_aud_usuario_creacion::text)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_per;
	            INSERT INTO tab_personal_servicio (n_personal_servicio_pk,n_tipo_documento, c_numero_documento, c_apellido_paterno,  c_apellido_materno,
	            c_nombres, c_telefono, c_correo_electronico, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_personal_servicio_pk'), rec._codigo_tipo_documento::integer, 
				UPPER(rec._numero_documento::text), UPPER(rec._apellido_paterno::text), UPPER(rec._apellido_materno::text),UPPER(rec._nombres::text), 
				rec._telefono::text, UPPER(rec._correo_electronico::text),pi_aud_usuario_creacion::text)
	            RETURNING n_personal_servicio_pk INTO v_personal_servicio_per;
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), v_personal_servicio_per, v_personal_contrato_per, pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_per;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso, c_aud_usuario_creacion, d_hora_ingreso, d_hora_salida,d_fecha_fin_contrato)
	            VALUES (nextval('sq_det_solicitud_personal_pk'), v_det_personal_contrato_per, rec._codigo_sede::integer, rec._oficina::text,
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'),to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'),	pi_aud_usuario_creacion::text , '08:30:00', '17:00:00', to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'));
	    	ELSIF existing_personal_per IS NOT NULL AND existing_contrato_per IS NULL  THEN
	            INSERT INTO tab_contrato (n_contrato_pk,d_fecha_inicio_contrato,d_fecha_fin_contrato,n_tipo_contrato, n_tipo_proceso_contrato, 
				n_proceso_electoral, --se esa tgragaedon
				c_numero_contrato, c_nombre_contrato, n_unidad_organica, n_sede, c_oficina, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_contrato_pk'), to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), rec._tipo_modalidad_contrato::integer,rec._tipo_proceso_contrato::integer,
				NULLIF(rec._codigo_proceso_electoral, '')::integer,
				--UPPER(rec._numero_contrato::text), 
				NULLIF(UPPER(rec._numero_contrato::text), ''), 
				UPPER(rec._nombre_contrato::text),
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            rec._codigo_sede::integer, rec._oficina::text,pi_aud_usuario_creacion::text)
	            RETURNING n_contrato_pk INTO v_n_contrato_per; 
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), v_n_contrato_per, pi_solicitud, pi_aud_usuario_creacion::text)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_per;
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), 
				(select n_personal_servicio_pk from tab_personal_servicio where n_activo=1 and UPPER(c_numero_documento) = UPPER(rec._numero_documento)
																				and n_tipo_documento::integer = rec._codigo_tipo_documento::integer   limit 1)::integer,
				v_personal_contrato_per, pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_per;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso,c_aud_usuario_creacion, d_hora_ingreso, d_hora_salida,d_fecha_fin_contrato)
	            VALUES (nextval('sq_det_solicitud_personal_pk'), v_det_personal_contrato_per, rec._codigo_sede::integer, rec._oficina::text,
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), pi_aud_usuario_creacion::text, '08:30:00', '17:00:00', to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'));
	    	ELSIF existing_contrato_per IS NOT NULL AND existing_personal_per IS NULL THEN
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), 
				(select n_contrato_pk from tab_contrato tc where n_activo=1 and UPPER(tc.c_numero_contrato) = UPPER(rec._numero_contrato) LIMIT 1 ) ::integer,
				pi_solicitud, pi_aud_usuario_creacion::text)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_per;
	            INSERT INTO tab_personal_servicio (n_personal_servicio_pk,n_tipo_documento, c_numero_documento, c_apellido_paterno,  c_apellido_materno,
	            c_nombres, c_telefono, c_correo_electronico, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_personal_servicio_pk'), rec._codigo_tipo_documento::integer, 
				UPPER(rec._numero_documento::text), UPPER(rec._apellido_paterno::text), UPPER(rec._apellido_materno::text),UPPER(rec._nombres::text), 
				rec._telefono::text, UPPER(rec._correo_electronico::text),pi_aud_usuario_creacion::text)
	            RETURNING n_personal_servicio_pk INTO v_personal_servicio_per;
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), v_personal_servicio_per, v_personal_contrato_per, pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_per;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso,c_aud_usuario_creacion, d_hora_ingreso, d_hora_salida,d_fecha_fin_contrato)
	            VALUES (nextval('sq_det_solicitud_personal_pk'), v_det_personal_contrato_per, rec._codigo_sede::integer, rec._oficina::text,
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'),pi_aud_usuario_creacion::text, '08:30:00', '17:00:00', to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'));
	    	ELSIF existing_personal_per IS NOT NULL AND existing_contrato_per IS NOT NULL  THEN
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), 
				(select n_contrato_pk from tab_contrato tc where n_activo=1 and UPPER(tc.c_numero_contrato) = UPPER(rec._numero_contrato) LIMIT 1 ) ::integer,
				pi_solicitud, pi_aud_usuario_creacion::text)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_per;
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), 
				(select n_personal_servicio_pk from tab_personal_servicio where n_activo=1 and UPPER(c_numero_documento) = UPPER(rec._numero_documento) 
																						   and n_tipo_documento::integer = rec._codigo_tipo_documento::integer   limit 1)::integer,
				v_personal_contrato_per, 
				pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_per;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso, c_aud_usuario_creacion, d_hora_ingreso, d_hora_salida,d_fecha_fin_contrato)
	            VALUES (nextval('sq_det_solicitud_personal_pk'), v_det_personal_contrato_per, rec._codigo_sede::integer, rec._oficina::text,
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), pi_aud_usuario_creacion::text, '08:30:00', '17:00:00', to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'));
			END IF;	
		END LOOP;
			SELECT COUNT(*) INTO v_tab_solicitud_evaluacion_per
			FROM tab_solicitud_evaluacion
			WHERE n_activo=1 and n_solicitud = pi_solicitud;
	    IF v_tab_solicitud_evaluacion_per = 0 THEN
	        INSERT INTO tab_solicitud_evaluacion (n_solicitud_evaluacion_pk, n_responsable, n_solicitud, c_aud_usuario_creacion)
	        VALUES (nextval('sq_tab_solicitud_evaluacion_pk'), (SELECT n_responsable FROM cab_solicitud WHERE n_solicitud_pk = pi_solicitud LIMIT 1)::integer, pi_solicitud::integer, pi_aud_usuario_creacion::text);
	    END IF;
		-----Actualizar el estado de la solicitud si la evaluación ya se encuentra a pendiente de aprobar registro
		IF EXISTS (
		    SELECT 1
		    FROM tab_solicitud_evaluacion
		    WHERE n_solicitud = pi_solicitud
		) THEN
		    UPDATE tab_solicitud_evaluacion
		    SET n_estado_solicitud = CASE 
		                                --WHEN DATE(d_aud_fecha_creacion) = CURRENT_DATE THEN 2
										WHEN d_aud_fecha_creacion::TIMESTAMP = CURRENT_TIMESTAMP THEN 2
										WHEN d_aud_fecha_creacion::TIMESTAMP < CURRENT_TIMESTAMP THEN 3
		                                --ELSE 3
		                             END
		    WHERE n_solicitud = pi_solicitud;
		END IF;
	END;
      po_resultado := 1;
	  --po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. '||pi_solicitud;
	  po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. ';
EXCEPTION
    WHEN OTHERS THEN
	EXECUTE 'set search_path =' ||pi_esquema;
	RAISE NOTICE 'po_mensaje =>%', sqlerrm;
        IF sqlerrm LIKE '%La persona ingresada ya cuenta con una solicitud%' THEN
            po_resultado := 2;
			po_mensaje := 'Registro(s) de Personal ya cuenta con una solicitud. Por favor, Validar.';
		ELSIF sqlerrm LIKE '%Error: La persona ingresada ya cuenta con un contrato válido%' THEN
	    po_resultado := 2;
	    po_mensaje := 'Registro(s) de Personal ya cuenta con un contrato. Por favor, Validar.'; 
		ELSE
            po_resultado := -1;
            po_mensaje := sqlerrm;
        END IF;
		 v_msg			:= 	'Error al cargar registros de personal ';
		 GET STACKED DIAGNOSTICS v_context = PG_EXCEPTION_CONTEXT;
		 CALL sp_registrar_log (pi_esquema::varchar, 'sp_pr_registrar_trama'::varchar, SQLSTATE::varchar, po_mensaje::varchar, v_context::varchar, pi_aud_usuario_creacion::varchar, v_msg::varchar);
END;
$procedure$
 ;]]></string>
		</procedure>
		<procedure name="sp_cargar_proveedor_lista_contrato" id="74dcc51e-6f54-49fd-9913-2cd35ae2ca32" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_proveedor_lista_contrato(IN pi_esquema text, IN pi_aud_usuario_creacion text, IN pi_n_carga_archivo integer, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 15/10/2024 */
	/* Modificado por:     */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_n_contrato_pro_list integer;
	v_n_empresa_pro_list  integer;
	--v_personal_servicio_pro_list  integer;
	v_personal_contrato_pro_list  integer;
	--v_det_personal_contrato_pro_list  integer;
	v_tab_solicitud_evaluacion_pro_list  integer;
	v_n_solicitud_pro_list   integer;
	v_estado_contrato_list  integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	existing_contrato_pro_list integer;
	--existing_personal_pro_list  integer;
	existing_empresa_pro_list  integer;
	contrato_rec RECORD;
	--persona_rec RECORD;
	empresa_rec RECORD;
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE --N_SOLICITUD = pi_solicitud AND 
			 n_carga_archivo_pk = pi_n_carga_archivo
		AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_proveedor_lista_contrato;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_proveedor_lista_contrato AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_proveedor_lista_contrato  
		LOOP
	        SELECT n_contrato_pk INTO existing_contrato_pro_list
	        FROM tab_contrato
	        WHERE UPPER(c_numero_contrato::text) = UPPER(rec._numero_contrato::text) and n_activo = 1;
			--<< ajuste aquí 01-10-2025
	        IF rec._numero_contrato IS NOT NULL AND rec._numero_contrato <> '' THEN
	            SELECT n_contrato_pk INTO existing_contrato_pro_list
	            FROM tab_contrato
	            WHERE UPPER(c_numero_contrato) = UPPER(rec._numero_contrato::text)   AND n_activo = 1;
	        ELSE
	            existing_contrato_pro_list := NULL;
	        END IF;
			/*
			---se comento Aqui un ajuste 01-10-2025
	        SELECT n_empresa_proveedor_pk INTO existing_empresa_pro_list
	        FROM mae_empresa_proveedor
	        WHERE UPPER(c_ruc::text) = UPPER(rec._ruc::text) and n_activo = 1;
			*/
		--1ra
	    IF existing_contrato_pro_list IS NULL AND existing_empresa_pro_list IS NULL THEN
				-
	            INSERT INTO mae_empresa_proveedor (n_empresa_proveedor_pk,c_razon_social,c_ruc,n_tipo_empresa, c_aud_usuario_creacion)
	            VALUES (nextval('sq_mae_empresa_proveedor_pk'),UPPER(rec._razon_social::text), UPPER(rec._ruc::text), rec._tipo_empresa::integer, pi_aud_usuario_creacion::text)
	            RETURNING n_empresa_proveedor_pk INTO v_n_empresa_pro_list; 
	            INSERT INTO tab_contrato (n_contrato_pk,d_fecha_inicio_contrato,d_fecha_fin_contrato,n_tipo_contrato,n_tipo_proceso_contrato,
				n_proceso_electoral, 
				c_numero_contrato, c_nombre_contrato, n_unidad_organica, n_sede,n_empresa_proveedor, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_contrato_pk'), to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), rec._tipo_modalidad_contrato::integer,rec._tipo_proceso_contrato::integer,
				NULLIF(rec._codigo_proceso_electoral, '')::integer,
				--UPPER(rec._numero_contrato::text), 
				NULLIF(UPPER(rec._numero_contrato::text), ''),  
				UPPER(rec._nombre_contrato::text),
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            rec._codigo_sede_contrato::integer,
				v_n_empresa_pro_list, 
				pi_aud_usuario_creacion::text)
	            RETURNING n_contrato_pk INTO v_n_contrato_pro_list; 
				--Insertar en cab_solicitud	
				INSERT INTO cab_solicitud (n_solicitud_pk,  n_responsable, n_tipo_solicitud, c_aud_usuario_creacion) 
				VALUES(nextval('sq_cab_solicitud_pk'), 
				(select n_responsable_pk  from tab_responsable tr where UPPER(tr.c_numero_documento) = UPPER(pi_aud_usuario_creacion)  LIMIT 1)::integer
				,2, pi_aud_usuario_creacion::text)
				RETURNING n_solicitud_pk INTO v_n_solicitud_pro_list;
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), 
				v_n_contrato_pro_list, 
				v_n_solicitud_pro_list, 
				pi_aud_usuario_creacion::text
				)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_pro_list;
				---
				INSERT INTO tab_solicitud_evaluacion (n_solicitud_evaluacion_pk, n_responsable,  n_solicitud, c_aud_usuario_creacion) 
				VALUES(nextval('sq_tab_solicitud_evaluacion_pk'),
				(select n_responsable_pk  from tab_responsable tr where UPPER(tr.c_numero_documento) = UPPER(pi_aud_usuario_creacion)  LIMIT 1)::integer
				,v_n_solicitud_pro_list, pi_aud_usuario_creacion::text);
		END IF;
		--2da
	    IF existing_empresa_pro_list IS NOT NULL AND existing_contrato_pro_list IS NULL THEN
	            INSERT INTO tab_contrato (n_contrato_pk,d_fecha_inicio_contrato,d_fecha_fin_contrato,n_tipo_contrato,n_tipo_proceso_contrato,
				n_proceso_electoral, --se esa tgragaedon
				c_numero_contrato, c_nombre_contrato, n_unidad_organica, n_sede, n_empresa_proveedor, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_contrato_pk'), to_timestamp(rec._fecha_inicio_contrato, 'DD/MM/YYYY'), to_timestamp(rec._fecha_fin_contrato, 'DD/MM/YYYY'), rec._tipo_modalidad_contrato::integer,rec._tipo_proceso_contrato::integer,
				NULLIF(rec._codigo_proceso_electoral, '')::integer,
				--UPPER(rec._numero_contrato::text), 
				NULLIF(UPPER(rec._numero_contrato::text), ''),  
				UPPER(rec._nombre_contrato::text),
	            (select n_unidad_organica_pk from mae_unidad_organica where n_activo=1 and UPPER(c_siglas) = UPPER(rec._siglas_unidad_organica) limit 1)::integer,
	            rec._codigo_sede_contrato::integer, 
 				(select n_empresa_proveedor_pk from mae_empresa_proveedor where n_activo=1 and UPPER(c_ruc) = UPPER(rec._ruc) LIMIT 1)::integer,
				pi_aud_usuario_creacion::text)
	            RETURNING n_contrato_pk INTO v_n_contrato_pro_list; 
				--Insertar en cab_solicitud	
				INSERT INTO cab_solicitud (n_solicitud_pk, n_responsable, n_tipo_solicitud, c_aud_usuario_creacion) 
				VALUES(nextval('sq_cab_solicitud_pk'),
				(select n_responsable_pk  from tab_responsable tr where UPPER(tr.c_numero_documento) = UPPER(pi_aud_usuario_creacion)  LIMIT 1)::integer
				, 2, pi_aud_usuario_creacion::text)
				RETURNING n_solicitud_pk INTO v_n_solicitud_pro_list;
	            INSERT INTO det_solicitud_contrato (n_det_solicitud_contrato_pk, n_contrato, n_solicitud, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_contrato_pk'), 
				v_n_contrato_pro_list, 
				v_n_solicitud_pro_list, 
				pi_aud_usuario_creacion::text
				)
	            RETURNING n_det_solicitud_contrato_pk INTO v_personal_contrato_pro_list;
				---
				INSERT INTO tab_solicitud_evaluacion (n_solicitud_evaluacion_pk, n_responsable,  n_solicitud, c_aud_usuario_creacion) 
				VALUES(nextval('sq_tab_solicitud_evaluacion_pk'), 
				(select n_responsable_pk  from tab_responsable tr where UPPER(tr.c_numero_documento) = UPPER(pi_aud_usuario_creacion)  LIMIT 1)::integer
				,v_n_solicitud_pro_list, pi_aud_usuario_creacion::text);
		END IF;
	END LOOP;
END;
    po_resultado := 1;
    --po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. '||pi_solicitud;
	po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. ';
EXCEPTION
    WHEN OTHERS THEN
	EXECUTE 'set search_path =' ||pi_esquema;
	RAISE NOTICE 'po_mensaje =>%', sqlerrm;
        IF sqlerrm LIKE 'Error: El contrato coincide, pero las empresas son diferentes%' THEN
            po_resultado := 2;
			po_mensaje := 'El número de contrato ya existe, pertenece a otra empresa';
		ELSIF sqlerrm LIKE '%La persona ingresada ya cuenta con una solicitud%' THEN
	    	po_resultado := 2;
	    	po_mensaje := 'Registro(s) de Personal de Empresa ya cuenta con una solicitud. Por favor, Validar.';
        ELSE
            po_resultado := -1;
            po_mensaje := sqlerrm;
        END IF;
		 v_msg			:= 	'Error al cargar registros de la lista de contratos';
		 GET STACKED DIAGNOSTICS v_context = PG_EXCEPTION_CONTEXT;
		 CALL sp_registrar_log (pi_esquema::varchar, 'sp_pr_registrar_trama'::varchar, SQLSTATE::varchar, po_mensaje::varchar, v_context::varchar, pi_aud_usuario_creacion::varchar, v_msg::varchar);
END;
$procedure$
 ;]]></string>
		</procedure>
		<procedure name="sp_cargar_proveedor_lista_personal" id="c8c821f0-7973-40ee-8ec1-a60e3eec8acc" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_proveedor_lista_personal(IN pi_esquema text, IN pi_solicitud integer, IN pi_aud_usuario_creacion text, IN pi_n_carga_archivo integer, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 14/2/2025 */
	/* Modificado por:     */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_personal_servicio_pro_gen integer;
	v_det_personal_contrato_pro_gen integer;
	v_tab_solicitud_evaluacion_pro_gen integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	existing_personal_pro_gen integer;
	persona_rec_gen RECORD;
	--empresa_rec_gen RECORD;
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE N_SOLICITUD = pi_solicitud 
		AND n_carga_archivo_pk = pi_n_carga_archivo
		AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_proveedor_lista_personal;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_proveedor_lista_personal AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_proveedor_lista_personal  
		LOOP
	        SELECT n_personal_servicio_pk INTO existing_personal_pro_gen
	        FROM tab_personal_servicio
	        WHERE UPPER(c_numero_documento) = UPPER(rec._numero_documento::text) 
			and rec._codigo_tipo_documento::integer = n_tipo_documento::integer  
			and n_activo = 1;
		--1ra
	    IF existing_personal_pro_gen IS NULL  THEN
	            INSERT INTO tab_personal_servicio (n_personal_servicio_pk,n_tipo_documento, c_numero_documento, c_apellido_paterno,  c_apellido_materno,
	            c_nombres, c_telefono, c_correo_electronico, c_aud_usuario_creacion)
	            VALUES (nextval('sq_tab_personal_servicio_pk'), rec._codigo_tipo_documento::integer, 
				UPPER(rec._numero_documento::text), UPPER(rec._apellido_paterno::text), UPPER(rec._apellido_materno::text), UPPER(rec._nombres::text), 
				rec._telefono::text, UPPER(rec._correo_electronico::text), pi_aud_usuario_creacion::text)
	            RETURNING n_personal_servicio_pk INTO v_personal_servicio_pro_gen;
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), v_personal_servicio_pro_gen, 
				(select n_det_solicitud_contrato_pk from det_solicitud_contrato where n_activo=1 and n_solicitud = pi_solicitud limit 1)::integer,
				pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_pro_gen;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, d_hora_ingreso,d_hora_salida,n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso, d_fecha_fin_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_personal_pk'),cast(rec._hora_inicio_acceso as time), cast(rec._hora_fin_acceso as time) , 
				v_det_personal_contrato_pro_gen, 
				rec._codigo_sede_acceso::integer, rec._oficina::text,
				(select n_unidad_organica from tab_contrato tc	inner join det_solicitud_contrato dsc on dsc.n_contrato = tc.n_contrato_pk and dsc.n_activo =1	where tc.n_activo =1 and  dsc.n_solicitud = pi_solicitud limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_acceso, 'DD/MM/YYYY'), 
	            to_timestamp(rec._fecha_fin_acceso, 'DD/MM/YYYY'),
				to_timestamp(rec._fecha_fin_acceso, 'DD/MM/YYYY'),
				pi_aud_usuario_creacion::text);
		--2da
		----Lógica para manejar el caso donde ya existe la empresa, persona pero no existe el contrato 
	    ELSIF 
				existing_personal_pro_gen IS NOT NULL  THEN				
	            INSERT INTO det_personal_contrato (n_det_personal_contrato_pk, n_personal_servicio, n_det_solicitud_contrato,c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_personal_contrato_pk'), 
				(select n_personal_servicio_pk from tab_personal_servicio where n_activo=1 and UPPER(c_numero_documento) = UPPER(rec._numero_documento) 
																				and rec._codigo_tipo_documento::integer = n_tipo_documento::integer  limit 1)::integer,	
				--v_personal_contrato_pro, --verse esto 
				(select n_det_solicitud_contrato_pk from det_solicitud_contrato where n_activo=1 and n_solicitud = pi_solicitud limit 1)::integer,
				pi_aud_usuario_creacion::text)
	            RETURNING n_det_personal_contrato_pk INTO v_det_personal_contrato_pro_gen;
	            INSERT INTO det_solicitud_personal (n_det_solicitud_personal_pk, d_hora_ingreso,d_hora_salida,n_det_personal_contrato,
	            n_sede, c_oficina,n_unidad_organica, d_fecha_inicio_acceso, d_fecha_fin_acceso,d_fecha_fin_contrato, c_aud_usuario_creacion)
	            VALUES (nextval('sq_det_solicitud_personal_pk'),cast(rec._hora_inicio_acceso as time), cast(rec._hora_fin_acceso as time) , 
				v_det_personal_contrato_pro_gen, 
				rec._codigo_sede_acceso::integer, rec._oficina::text,
				(select n_unidad_organica from tab_contrato tc	inner join det_solicitud_contrato dsc on dsc.n_contrato = tc.n_contrato_pk and dsc.n_activo =1	where tc.n_activo =1 and  dsc.n_solicitud = pi_solicitud limit 1)::integer,
	            to_timestamp(rec._fecha_inicio_acceso, 'DD/MM/YYYY'), 
				to_timestamp(rec._fecha_fin_acceso, 'DD/MM/YYYY'),
				to_timestamp(rec._fecha_fin_acceso, 'DD/MM/YYYY'),
				pi_aud_usuario_creacion::text);
	end if;
		END LOOP;
		SELECT COUNT(*) INTO v_tab_solicitud_evaluacion_pro_gen
		FROM tab_solicitud_evaluacion
		WHERE n_activo=1 and n_solicitud = pi_solicitud;
	    IF v_tab_solicitud_evaluacion_pro_gen = 0 THEN
	        INSERT INTO tab_solicitud_evaluacion (n_solicitud_evaluacion_pk, n_responsable, n_solicitud, c_aud_usuario_creacion)
	        VALUES (nextval('sq_tab_solicitud_evaluacion_pk'), (SELECT n_responsable FROM cab_solicitud WHERE n_solicitud_pk = pi_solicitud LIMIT 1)::integer, pi_solicitud::integer, pi_aud_usuario_creacion::text);
	    END IF;
		-----Actualizar el estado de la solicitud si la evaluación ya se encuentra a pendiente de aprobar registro
		IF EXISTS (
		    SELECT 1
		    FROM tab_solicitud_evaluacion
		    WHERE n_solicitud = pi_solicitud
		) THEN
		    UPDATE tab_solicitud_evaluacion
		    SET n_estado_solicitud = 3 /*CASE 		                                						
										WHEN n_estado_solicitud = 1 THEN 3  
										WHEN n_estado_solicitud = 2 THEN 3  
										WHEN n_estado_solicitud = 3 THEN 3  
		                               ELSE 3
		                             END*/
		    WHERE n_solicitud = pi_solicitud;
		END IF;
	END;
    po_resultado := 1;
    --po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. '||pi_solicitud;
	po_mensaje := 'La solicitud fue enviada y está pendiente de aprobación. ';
EXCEPTION
    WHEN OTHERS THEN
	EXECUTE 'set search_path =' ||pi_esquema;
	RAISE NOTICE 'po_mensaje =>%', sqlerrm;
        IF sqlerrm LIKE '%Error: %' THEN
            po_resultado := 2;
			po_mensaje := 'El';
		ELSIF sqlerrm LIKE '%La%' THEN
	    	po_resultado := 2;
	    	po_mensaje := 'Registro(s).';
        ELSE
            po_resultado := -1;
            po_mensaje := sqlerrm;
        END IF;
		 v_msg			:= 	'Error al cargar registros de proveedor Lista Personal';
		 GET STACKED DIAGNOSTICS v_context = PG_EXCEPTION_CONTEXT;
		 CALL sp_registrar_log (pi_esquema::varchar, 'sp_pr_registrar_trama'::varchar, SQLSTATE::varchar, po_mensaje::varchar, v_context::varchar, pi_aud_usuario_creacion::varchar, v_msg::varchar);
END;
$procedure$
 ;]]></string>
		</procedure>
		<procedure name="sp_cargar_visita" id="22685488-fab7-4d65-a675-7fee708749cc" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_cargar_visita(IN pi_esquema text, IN pi_solicitud integer, IN pi_aud_usuario_creacion text, IN pi_id_coordinador integer, OUT po_resultado integer, OUT po_mensaje text)
 LANGUAGE plpgsql
AS $procedure$
DECLARE 
		/**********************************/
	/* Procedimiento que realiza la carga de personal */
	/* Elaborado por: Romaldo Nolasco Fecha de creación: 08/10/2024 */
	/* Modificado por:     */
	/**/
	-
	-
	/**********************************/
	/* inicio declaración de variables */
	sQueryCrea text;
	v_context text;
	v_detail text;
	v_msg text; 
	VC_PUBLIC text := 'PUBLIC';
	VN_CARGA_PK integer;
	rec RECORD;
	v_personal_servicio_vis integer;
	v_personal_contrato_vis integer;
	v_det_personal_contrato_vis integer;
	v_tab_solicitud_evaluacion_vis integer;
	existing_personal_vis integer;
	v_existe_det_solicitud integer;
	conflict_list TEXT := ''; 
    conflict_records RECORD; 
	/* fin declaración de variables */
BEGIN
	/* inicio sección de instrucciones */		
	BEGIN
		EXECUTE 'SET search_path =' || pi_esquema || ',' || VC_PUBLIC;
		SELECT N_CARGA_ARCHIVO_PK INTO VN_CARGA_PK
		FROM CAB_CARGA_ARCHIVO
		WHERE N_SOLICITUD = pi_solicitud AND N_ACTIVO = 1;
		SELECT fn_filacolumna(pi_esquema, 'DET_CARGA_ARCHIVO', 'n_fila', 'c_clave', 'c_valor', 'text', VN_CARGA_PK) INTO sQueryCrea;
		EXECUTE 'DROP VIEW IF EXISTS ' || pi_esquema || '.vw_carga_masiva_visita;';
		sQueryCrea := 'CREATE OR REPLACE VIEW ' || pi_esquema || '.vw_carga_masiva_visita AS ' || sQueryCrea;
		EXECUTE sQueryCrea;
	END;
	BEGIN
		FOR rec IN 
	        SELECT * 
	        FROM vw_carga_masiva_visita  
		LOOP
			/*
		    CREATE TEMP TABLE temp_exact_conflicts_vis AS
		    SELECT 
		        a1.numero_documento,
		        a1.c_estado_solicitud_detalle,
		        a1.fecha_inicio_acceso,
		        a1.fecha_fin_acceso,
		        a1.hora_ingreso,
		        a1.hora_salida,
				a1.sede,
				a1.tipo_documento
		        --a1.numero_contrato
		    FROM (
		        SELECT 
		            --tc.c_numero_contrato AS numero_contrato,
		            dsp.d_fecha_inicio_acceso::DATE AS fecha_inicio_acceso,
		            dsp.d_fecha_fin_acceso::DATE AS fecha_fin_acceso,
		            tps.c_numero_documento AS numero_documento,
					tps.n_tipo_documento as tipo_documento,
		            dce.c_nombre AS c_estado_solicitud_detalle,
		            dsp.d_hora_ingreso hora_ingreso,
		            dsp.d_hora_salida hora_salida,
					dsp.n_sede sede
		        --FROM tab_contrato tc
		        --INNER JOIN 
		        from det_solicitud_contrato dsc --ON dsc.n_contrato = tc.n_contrato_pk 
		        INNER JOIN cab_solicitud cs ON cs.n_solicitud_pk = dsc.n_solicitud AND cs.n_tipo_solicitud = 5 and cs.n_activo=1
		        INNER JOIN tab_solicitud_evaluacion tse ON tse.n_solicitud = cs.n_solicitud_pk 
		            AND tse.n_estado_solicitud IN (1, 2, 3)
		        INNER JOIN det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1 
		        INNER JOIN det_solicitud_personal dsp ON dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk 
		            AND dsp.n_estado_solicitud_detalle IN (1, 2) 
		            AND dsp.n_activo = 1
		        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = dsp.n_estado_solicitud_detalle 
		            AND dce.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' and dce.n_activo=1
		        INNER JOIN tab_personal_servicio tps ON tps.n_personal_servicio_pk = dpc.n_personal_servicio and tps.n_activo=1
		    ) a1
		    WHERE UPPER(a1.numero_documento) = UPPER(rec._numero_documento)
			  and a1.tipo_documento::integer =  rec._codigo_tipo_documento::integer
		      AND a1.hora_ingreso = rec._hora_inicio_acceso::TIME
		      AND a1.hora_salida = rec._hora_fin_acceso::TIME
			  AND a1.sede = rec._codigo_sede::integer
		      AND a1.fecha_inicio_acceso::DATE = TO_DATE(rec._fecha_inicio_acceso, 'DD/MM/YYYY')
			  AND a1.fecha_fin_acceso::DATE = TO_DATE(rec._fecha_fin_acceso, 'DD/MM/YYYY');
		    IF EXISTS (SELECT 1 FROM temp_exact_conflicts_vis) THEN
		        FOR conflict_records IN SELECT * FROM temp_exact_conflicts_vis LOOP
		            conflict_list := conflict_list || E'\n- Documento: ' || conflict_records.numero_documento 
													 || ', Tipo Documento: ' || conflict_records.tipo_documento
		                                             || ', Hora Inicio: ' || conflict_records.hora_ingreso
		                                             || ', Hora Fin: ' || conflict_records.hora_salida
													 || ', Sede: ' || conflict_records.sede
		                                             || ', Estado: ' || conflict_records.c_estado_solicitud_detalle
		                                             || ', Fecha Inicio: ' || conflict_records.fecha_inicio_acceso
		                                             || ', Fecha Fin: ' || conflict_records.fecha_fin_acceso;
		        END LOOP;
		        RAISE EXCEPTION 'Error: La persona ingresada ya cuenta con una visita válido';
		    ELSE
		        RAISE NOTICE 'No se encontraron conflictos. Continuando con la operación.';
		    END IF;]]></string>
		</procedure>
		<procedure name="sp_migracion_cas_cap" id="f65f0abd-dbad-47a8-8970-cf67bcf549ef" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_migracion_cas_cap()
 LANGUAGE plpgsql
AS $procedure$
BEGIN
---INSERCIÓN Y ACTUALIZACIÓN DE CARGO
	INSERT INTO mae_cargo (n_cargo_pk, c_abreviatura, c_cargo, n_activo, c_aud_usuario_creacion, d_aud_fecha_creacion, c_aud_usuario_modificacion, d_aud_fecha_modificacion)
	SELECT 
	    t.n_tmp_cargo_pk n_cargo_pk,
	    t.c_abreviatura,
	    t.c_cargo,
	    t.n_activo,
	    t.c_aud_usuario_creacion,
	    t.d_aud_fecha_creacion,
	    t.c_aud_usuario_modificacion,
	    t.d_aud_fecha_modificacion
	FROM tmp_mae_cargo t ON CONFLICT (n_cargo_pk) 
	DO UPDATE
	SET 
	    c_abreviatura = EXCLUDED.c_abreviatura,
	    c_cargo = EXCLUDED.c_cargo,
	    n_activo = EXCLUDED.n_activo,
	    c_aud_usuario_creacion = EXCLUDED.c_aud_usuario_creacion,
	    d_aud_fecha_creacion = EXCLUDED.d_aud_fecha_creacion,
	    c_aud_usuario_modificacion = EXCLUDED.c_aud_usuario_modificacion,
	    d_aud_fecha_modificacion = EXCLUDED.d_aud_fecha_modificacion;
	   --INSERCIÓN Y ACTUALIZACIÓN DE UNIDAD ORGANICA
	INSERT INTO mae_unidad_organica (
	    n_unidad_organica_pk, n_codigo_unidad_organica, c_nombre,c_siglas, n_padre,n_nivel, n_activo,c_aud_usuario_creacion, d_aud_fecha_creacion,c_aud_usuario_modificacion, d_aud_fecha_modificacion)
	SELECT 
	    t.n_tmp_unidad_organica_pk n_unidad_organica_pk,
	    t.n_codigo_unidad_organica,
	    t.c_nombre,
	    t.c_siglas,
	    t.n_padre,
	    t.n_nivel,
	    t.n_activo,
	    t.c_aud_usuario_creacion,
	    t.d_aud_fecha_creacion,
	    t.c_aud_usuario_modificacion,
	    t.d_aud_fecha_modificacion
	FROM tmp_mae_unidad_organica t ON CONFLICT (n_unidad_organica_pk) 
	DO UPDATE
	SET 
	    n_codigo_unidad_organica = EXCLUDED.n_codigo_unidad_organica,
	    c_nombre = EXCLUDED.c_nombre,
	    c_siglas = EXCLUDED.c_siglas,
	    n_padre = EXCLUDED.n_padre,
	    n_nivel = EXCLUDED.n_nivel,
	    n_activo = EXCLUDED.n_activo,
	    c_aud_usuario_creacion = EXCLUDED.c_aud_usuario_creacion,
	    d_aud_fecha_creacion = EXCLUDED.d_aud_fecha_creacion,
	    c_aud_usuario_modificacion = EXCLUDED.c_aud_usuario_modificacion,
	    d_aud_fecha_modificacion = EXCLUDED.d_aud_fecha_modificacion;
	--INSERCIÓN Y ACTUALIZACIÓN DE PERSONAL CAS CAP
-
INSERT INTO tab_personal_cas_cap (n_personal_cas_cap_pk,
	    n_tipo_documento,c_numero_documento, c_apellido_paterno,c_apellido_materno,	c_nombres,	d_fecha_inicio_contrato,d_fecha_fin_contrato,d_hora_ingreso,d_hora_salida,n_sede,c_oficina,n_cargo,n_unidad_organica,n_tipo_contrato,c_numero_contrato,	c_nombre_contrato,c_telefono,
	    c_numero_anexo,c_correo_electronico,n_activo, c_aud_usuario_creacion,d_aud_fecha_creacion, c_aud_usuario_modificacion,d_aud_fecha_modificacion)
	SELECT 
		nextval('sigap.sq_tab_personal_cas_cap_pk'), 
	    ttpcc.n_tipo_documento,
	    ttpcc.c_numero_documento,
	    ttpcc.c_apellido_paterno,
	    ttpcc.c_apellido_materno,
	    ttpcc.c_nombres,
	    ttpcc.d_fecha_inicio_contrato,
	    ttpcc.d_fecha_fin_contrato,
	    ttpcc.d_hora_ingreso,
	    ttpcc.d_hora_salida,
	    ttpcc.n_sede,
	    ttpcc.c_oficina,
	    tmc.n_tmp_cargo_pk n_cargo,
	    tmuo.n_tmp_unidad_organica_pk n_unidad_organica,
	    ttpcc.n_tipo_contrato,
	    ttpcc.c_numero_contrato,
	    ttpcc.c_nombre_contrato,
	    ttpcc.c_telefono,
	    ttpcc.c_numero_anexo,
	    ttpcc.c_correo_electronico,
	    ttpcc.n_activo,
	    ttpcc.c_aud_usuario_creacion,
	    ttpcc.d_aud_fecha_creacion,
	    ttpcc.c_aud_usuario_modificacion,
	    ttpcc.d_aud_fecha_modificacion
	FROM  (select * from (select ROW_NUMBER() OVER (PARTITION BY c_numero_documento ORDER BY d_fecha_inicio_contrato desc, d_fecha_fin_contrato DESC) AS fila, *
						  from tmp_tab_personal_cas_cap ttpcc) a1 where fila = 1) ttpcc
	LEFT JOIN tmp_mae_cargo tmc ON tmc.n_tmp_cargo_pk = ttpcc.n_cargo
	LEFT JOIN tmp_mae_unidad_organica tmuo ON tmuo.n_tmp_unidad_organica_pk = ttpcc.n_unidad_organica
	ON CONFLICT (c_numero_documento) 
	DO UPDATE
	SET 
	    n_tipo_documento = EXCLUDED.n_tipo_documento,
	    c_apellido_paterno = EXCLUDED.c_apellido_paterno,
	    c_apellido_materno = EXCLUDED.c_apellido_materno,
	    c_nombres = EXCLUDED.c_nombres,
	    d_fecha_inicio_contrato = EXCLUDED.d_fecha_inicio_contrato,
	    d_fecha_fin_contrato = EXCLUDED.d_fecha_fin_contrato,
	    d_hora_ingreso = EXCLUDED.d_hora_ingreso,
	    d_hora_salida = EXCLUDED.d_hora_salida,
	    n_sede = EXCLUDED.n_sede,
	    c_oficina = EXCLUDED.c_oficina,
	    n_cargo = EXCLUDED.n_cargo,
	    n_unidad_organica = EXCLUDED.n_unidad_organica,
	    n_tipo_contrato = EXCLUDED.n_tipo_contrato,
	    c_numero_contrato = EXCLUDED.c_numero_contrato,
	    c_nombre_contrato = EXCLUDED.c_nombre_contrato,
	    c_telefono = EXCLUDED.c_telefono,
	    c_numero_anexo = EXCLUDED.c_numero_anexo,
	    c_correo_electronico = EXCLUDED.c_correo_electronico,
	    n_activo = EXCLUDED.n_activo,
	    c_aud_usuario_modificacion = EXCLUDED.c_aud_usuario_modificacion,
	    d_aud_fecha_modificacion = EXCLUDED.d_aud_fecha_modificacion;
	---ACTUALIZACIÓN DEL ESTADO DEL PERSONAL EN CASO EL PERSONAL CAS CAP YA SE ENCUENTRA INACTIVO EN SARHA
	update tab_personal_cas_cap
		set n_activo = 0, 
			c_aud_usuario_modificacion = 'SIGAP',
			d_aud_fecha_creacion = current_timestamp 
	where c_numero_documento not in (select c_numero_documento from tmp_tab_personal_cas_cap)	  
	  and n_activo=1;
	INSERT INTO tab_proceso_electoral (n_proceso_electoral_pk, c_id_proceso, c_nombre, c_acronimo, n_baja, d_fecha_registro_incidencia, c_id_proceso_base, n_base, n_activo, c_aud_usuario_creacion, d_aud_fecha_creacion, c_aud_usuario_modificacion, d_aud_fecha_modificacion)
	SELECT 
	    t.n_tmp_proceso_electoral_pk AS n_proceso_electoral_pk,
	    t.c_id_proceso,
	    t.c_nombre,
	    t.c_acronimo,
	    t.n_baja,
	    t.d_fecha_registro_incidencia,
	    t.c_id_proceso_base,
	    t.n_base,
	    t.n_activo,
	    t.c_aud_usuario_creacion,
	    t.d_aud_fecha_creacion,
	    t.c_aud_usuario_modificacion,
	    t.d_aud_fecha_modificacion
	FROM tmp_tab_proceso_electoral t
	ON CONFLICT (n_proceso_electoral_pk) 
	DO UPDATE
	SET 
	    c_id_proceso = EXCLUDED.c_id_proceso,
	    c_nombre = EXCLUDED.c_nombre,
	    c_acronimo = EXCLUDED.c_acronimo,
	    n_baja = EXCLUDED.n_baja,
	    d_fecha_registro_incidencia = EXCLUDED.d_fecha_registro_incidencia,
	    c_id_proceso_base = EXCLUDED.c_id_proceso_base,
	    n_base = EXCLUDED.n_base,
	    n_activo = EXCLUDED.n_activo,
	    c_aud_usuario_creacion = EXCLUDED.c_aud_usuario_creacion,
	    d_aud_fecha_creacion = EXCLUDED.d_aud_fecha_creacion,
	    c_aud_usuario_modificacion = EXCLUDED.c_aud_usuario_modificacion,
	    d_aud_fecha_modificacion = EXCLUDED.d_aud_fecha_modificacion;
END;
$procedure$
 ;]]></string>
		</procedure>
		<procedure name="sp_registrar_log" id="a7734837-921b-40de-8a39-19d5707610bf" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE PROCEDURE sigap_anthony.sp_registrar_log(IN pi_esquema character varying, IN pi_objeto character varying, IN pi_sql_error character varying, IN pi_sql_text character varying, IN pi_sql_context character varying DEFAULT NULL::character varying, IN pi_usuario character varying DEFAULT NULL::character varying, IN pi_mensaje character varying DEFAULT NULL::character varying)
 LANGUAGE plpgsql
AS $procedure$
DECLARE
    v_linea           varchar;
BEGIN
	EXECUTE 'set search_path =' ||pi_esquema;
	CASE 
		WHEN POSITION(' línea ' in pi_sql_context)>0 THEN 
			v_linea := TRIM(SUBSTRING(pi_sql_context, 
					  POSITION(' línea ' in pi_sql_context)+1,
					  LENGTH(pi_sql_context)));
		WHEN POSITION(' line ' in pi_sql_context)>0 THEN 
			v_linea := TRIM(SUBSTRING(pi_sql_context, 
					  POSITION(' line ' in pi_sql_context)+1,
					  LENGTH(pi_sql_context)));
		ELSE
			v_linea := null;
	END CASE;			
    INSERT INTO tab_log
      (c_objeto,
      d_fecha_error,
      c_sql_error,
      c_sql_text,
	  c_sql_context,
      c_linea,
      c_usuario,
      c_mensaje)
	VALUES
      (pi_objeto,
       CURRENT_TIMESTAMP,
       pi_sql_error,
       pi_sql_text,
	   pi_sql_context,
       v_linea,
       pi_usuario,
       pi_mensaje);
    --COMMIT;
EXCEPTION
      WHEN OTHERS THEN
        RAISE NOTICE 'po_mensaje =>%', SQLERRM;
END;
$procedure$
 ;]]></string>
		</procedure>
		<function name="fn_actualizar_vigencia_personal" id="16f8f00c-0312-4ee9-9426-eafacd537215" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_actualizar_vigencia_personal(pi_esquema character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$
DECLARE
    n_cant_1 INTEGER := 0;
    n_cant_2 INTEGER := 0;
    n_cant_3 INTEGER := 0;
    n_cant_4 INTEGER := 0;
    n_cant_5 INTEGER := 0;
    n_cant_6 INTEGER := 0;
    n_cant_7 INTEGER := 0;
    n_cant_8 INTEGER := 0;
	n_cant_9 INTEGER := 0;
    json_result JSON;
BEGIN
	EXECUTE 'SET search_path =' || pi_esquema; 
    IF EXISTS (
        SELECT 1
        FROM sigap.tab_actualizar_vigencia_personal
        WHERE d_aud_fecha_creacion::DATE = CURRENT_DATE
    ) THEN
        RETURN json_build_object(
            'Estado', 'Saltar',
            'Mensaje', 'La actualización de vigencia ya se ejecutó hoy.',
            'Fecha', CURRENT_DATE
        );
    END IF;
	---Si el detalle de la solicitud personal se verifica que la d_fecha_fin_acceso es menor a la fecha actual y se encuentra activo= 1, se realiza un cambio de estado n_activo = 0
	update sigap.det_solicitud_personal 
		set n_vigente = 0, d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	where n_activo =1 
			and n_estado_solicitud_detalle = 1 
			and n_vigente=1
			and TO_CHAR(d_fecha_fin_acceso , 'YYYY-MM-DD') < TO_CHAR(CURRENT_DATE, 'YYYY-MM-DD');
	GET DIAGNOSTICS n_cant_1 = ROW_COUNT;
	   	---Si el detalle de la solicitud equipo vehículo se verifica que la d_fecha_fin_acceso es menor a la fecha actual y se encuentra activo= 1, se realiza un cambio de estado n_activo = 0
	update sigap.det_solicitud_equipo_vehiculo 
		set n_vigente =0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	where n_activo =1 
			and n_estado_solicitud_detalle = 1 and n_vigente=1
			and TO_CHAR(d_fecha_fin_acceso , 'YYYY-MM-DD') < TO_CHAR(CURRENT_DATE, 'YYYY-MM-DD');	   
	GET DIAGNOSTICS n_cant_7 = ROW_COUNT;
/*
	---Si el contrato del personal y del proveedor se verifica la d_fecha_fin_contrato es menor a la fecha actual y se encuentra n_activo= 1, se realiza un cambio de estado n_activo = 0
	UPDATE sigap.tab_contrato tc
		SET n_activo = 0
	WHERE tc.n_contrato_pk IN (
		SELECT tc.n_contrato_pk 
	    FROM sigap.cab_solicitud cs
	    INNER JOIN sigap.det_solicitud_contrato dsc ON dsc.n_solicitud = cs.n_solicitud_pk
	    inner join sigap.tab_contrato tc on tc.n_contrato_pk = dsc.n_contrato and tc.n_activo =1
	    INNER JOIN sigap.det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk 
	    INNER JOIN sigap.det_solicitud_personal dsp ON dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and n_estado_solicitud_detalle = 1	    
	    WHERE cs.n_activo = 1 and  TO_CHAR(tc.d_fecha_fin_contrato , 'YYYY-MM-DD') < TO_CHAR(CURRENT_DATE, 'YYYY-MM-DD')
	 	);
	GET DIAGNOSTICS n_cant_2 = ROW_COUNT;
	  */ 
	---Si la solicitud de tipo personal, comisión de servicios, jornada extendida, visita se encuentra con el estado n_activo = 1 y no tiene ni una solicitud detalle n_activo = 1, se realiza un cambio de estado n_activo = 0
	UPDATE sigap.cab_solicitud cs
		SET n_vigente = 0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE cs.n_solicitud_pk IN (	    
		SELECT cs.n_solicitud_pk
	    FROM sigap.cab_solicitud cs
	    INNER JOIN sigap.det_solicitud_contrato dsc ON dsc.n_solicitud = cs.n_solicitud_pk and dsc.n_activo=1
	    INNER JOIN sigap.det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1
	    INNER JOIN sigap.det_solicitud_personal dsp ON dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and dsp.n_estado_solicitud_detalle = 1 
																			and dsp.n_activo=1 --and dsp.n_vigente=1 
	    WHERE cs.n_activo = 1 and cs.n_vigente= 1 and cs.n_tipo_solicitud in (1,3,4,5) 
	    GROUP BY cs.n_solicitud_pk
		HAVING COUNT(dsp.n_vigente) = COUNT(CASE WHEN dsp.n_vigente = 0 THEN 1 END)
	);
	GET DIAGNOSTICS n_cant_3 = ROW_COUNT;
	---Si la solicitud de  equipo vehículose encuentra con el estado n_activo = 1 y no tiene ni una solicitud detalle de  equipo vehículo n_activo = 1, se realiza un cambio de estado n_activo = 0
	UPDATE sigap.cab_solicitud_equipo_vehiculo cs
		SET n_vigente = 0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE cs.n_solicitud_equipo_vehiculo_pk IN (	    
		SELECT cs.n_solicitud_equipo_vehiculo_pk 
	    FROM sigap.cab_solicitud_equipo_vehiculo cs
	    INNER JOIN sigap.det_solicitud_equipo_vehiculo dsp ON dsp.n_solicitud_equipo_vehiculo = cs.n_solicitud_equipo_vehiculo_pk and n_estado_solicitud_detalle = 1 
																								and  dsp.n_activo=1
	    WHERE cs.n_activo = 1 and cs.n_vigente= 1
	    GROUP BY cs.n_solicitud_equipo_vehiculo_pk
	    HAVING COUNT(dsp.n_vigente) = COUNT(CASE WHEN dsp.n_vigente = 0 THEN 1 END)
	); 
	GET DIAGNOSTICS n_cant_8 = ROW_COUNT;
	---Si la solicitud de tipo proveedor se encuentra con el estado n_activo = 1 y no tiene ni una solicitud detalle n_activo = 1, se realiza un cambio de estado n_activo = 0
	UPDATE sigap.cab_solicitud cs
		SET n_vigente = 0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE cs.n_solicitud_pk IN (	    
		SELECT cs.n_solicitud_pk
	    FROM sigap.cab_solicitud cs
		inner join sigap.tab_solicitud_evaluacion tse on tse.n_solicitud = cs.n_solicitud_pk and tse.n_estado_solicitud=1
	    INNER JOIN sigap.det_solicitud_contrato dsc ON dsc.n_solicitud = cs.n_solicitud_pk
	    inner join (SELECT n_contrato_pk,d_fecha_fin_contrato, CASE WHEN d_fecha_fin_contrato < CURRENT_DATE THEN 0 WHEN d_fecha_fin_contrato >= CURRENT_DATE THEN 1 END AS n_vigente
					FROM sigap.tab_contrato where n_activo=1) tc on tc.n_contrato_pk = dsc.n_contrato 
	    INNER JOIN sigap.det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk 
	    WHERE cs.n_activo = 1 and cs.n_vigente=1 and cs.n_tipo_solicitud in (2) and TO_CHAR(tc.d_fecha_fin_contrato , 'YYYY-MM-DD') < TO_CHAR(CURRENT_DATE, 'YYYY-MM-DD')
	    GROUP BY cs.n_solicitud_pk
	    HAVING COUNT(tc.n_vigente) = COUNT(CASE WHEN tc.n_vigente = 0 THEN 1 END)
	);
	GET DIAGNOSTICS n_cant_4 = ROW_COUNT;
	---Si la solicitud de tipo proveedor no tiene personal y se encuentra con el estado n_activo = 1 y no tiene ni una solicitud detalle n_activo = 1, se realiza un cambio de estado n_activo = 0
	UPDATE sigap.cab_solicitud cs
		SET n_vigente = 0 , d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE cs.n_solicitud_pk IN (	    
		SELECT cs.n_solicitud_pk
	    FROM sigap.cab_solicitud cs
		inner join sigap.tab_solicitud_evaluacion tse on tse.n_solicitud = cs.n_solicitud_pk and tse.n_estado_solicitud=1
	    INNER JOIN sigap.det_solicitud_contrato dsc ON dsc.n_solicitud = cs.n_solicitud_pk
	    inner join (SELECT n_contrato_pk,d_fecha_fin_contrato, CASE WHEN d_fecha_fin_contrato < CURRENT_DATE THEN 0 WHEN d_fecha_fin_contrato >= CURRENT_DATE THEN 1 END AS n_vigente
					FROM sigap.tab_contrato where n_activo=1) tc on tc.n_contrato_pk = dsc.n_contrato 			
	    LEFT JOIN sigap.det_personal_contrato dpc ON dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk  
	    WHERE     dpc.n_det_solicitud_contrato is  NULL
	 	      and cs.n_activo = 1 and cs.n_vigente=1 and cs.n_tipo_solicitud in (2) 
	 	      and TO_CHAR(tc.d_fecha_fin_contrato , 'YYYY-MM-DD') < TO_CHAR(CURRENT_DATE, 'YYYY-MM-DD')
	    GROUP BY cs.n_solicitud_pk
	    HAVING COUNT(tc.n_vigente) = COUNT(CASE WHEN tc.n_vigente = 0 THEN 1 END)
	);
	GET DIAGNOSTICS n_cant_9 = ROW_COUNT;
	-----Si el personal servicio registrada en el directorio no tiene ni una solicitud n_activo = 1 se desactiva en el directorio n_activo = 0
	UPDATE sigap.tab_directorio td
		SET n_vigente = 0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE td.n_directorio_pk IN (
		SELECT td.n_directorio_pk 
	    FROM sigap.tab_directorio td
	    inner join sigap.tab_personal_servicio tps on tps.n_personal_servicio_pk = td.n_personal_servicio and tps.n_activo =1
	    inner join sigap.det_personal_contrato dpc on dpc.n_personal_servicio = tps.n_personal_servicio_pk and dpc.n_activo=1
	    inner join sigap.det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and n_estado_solicitud_detalle = 1 and dsp.n_activo=1	    
	    WHERE td.n_activo = 1 and td.n_vigente=1
	    group by td.n_directorio_pk
	    HAVING COUNT(dsp.n_vigente) = COUNT(CASE WHEN dsp.n_vigente = 0 THEN 1 END)
	    );
	 GET DIAGNOSTICS n_cant_5 = ROW_COUNT;
	-----Si el personal cas cap registrada en el directorio no tiene ni una solicitud n_activo = 1 se desactiva en el directorio n_activo = 0 
	UPDATE sigap.tab_directorio td
		SET n_vigente = 0 ,d_aud_fecha_modificacion = CURRENT_TIMESTAMP 
	WHERE td.n_directorio_pk IN (
		SELECT td.n_directorio_pk 
	    FROM sigap.tab_directorio td
	    inner join sigap.tab_personal_cas_cap tps on tps.n_personal_cas_cap_pk = td.n_personal_cas_cap and tps.n_activo =1
	    inner join sigap.det_personal_contrato dpc on dpc.n_personal_cas_cap = tps.n_personal_cas_cap_pk and dpc.n_activo=1
	    inner join sigap.det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and n_estado_solicitud_detalle = 1	and dsp.n_activo=1	    
	    WHERE td.n_activo = 1 and td.n_vigente=1
	    group by td.n_directorio_pk
	    HAVING COUNT(dsp.n_vigente) = COUNT(CASE WHEN dsp.n_vigente = 0 THEN 1 END)
	    );
	   GET DIAGNOSTICS n_cant_6 = ROW_COUNT;
    json_result := json_build_object(
        'n_cant_1_det_solicitud_personal', n_cant_1,
        'n_cant_2_tab_contrato', n_cant_2,
        'n_cant_3_cab_solicitud_personal', n_cant_3,
        'n_cant_4_cab_solicitud_proveedor', n_cant_4,
        'n_cant_5_tab_directorio_personal', n_cant_5,
        'n_cant_6_tab_directorio_cas_cap', n_cant_6,
        'n_cant_7_det_solicitud_equipo_vehiculo', n_cant_7,
        'n_cant_8_cab_solicitud_equipo_vehiculo', n_cant_8,
		'n_cant_9_cab_solicitud_proveedor_contrato', n_cant_9
    );
	    INSERT INTO sigap.tab_actualizar_vigencia_personal ( c_descripcion, c_informacion_adicional, c_aud_usuario_creacion)
	    VALUES ('Se realizó la actualización de vigencia del personal de manera exitosa', json_result, '00000');
RETURN json_build_object(
        'Estado', 'Correcto',
        'Mensaje', 'Actualización de vigencia ejecutada correctamente.',
		'Fecha', CURRENT_DATE
    );
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_filacolumna" id="e2c1ce2d-2c04-4a8c-9c97-5d8030deb31a" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_filacolumna(esquema character varying, tabla character varying, rowc character varying, colc character varying, cellc character varying, celldatatype character varying, idtipoarchivo integer)
 RETURNS character varying
 LANGUAGE plpgsql
AS $function$
declare
    dynsql1 varchar;
    dynsql2 varchar;
    columnlist varchar;
begin
    dynsql1 = 'select string_agg(distinct ''_''||'||colc||'||'' '||celldatatype||''','','' order by ''_''||'||colc||'||'' '||celldatatype||''') from '||esquema||'.'||tabla||' where n_carga_archivo='||idtipoarchivo||' and n_activo = 1;';
    execute dynsql1 into columnlist;
    dynsql2 = 'select * from public.crosstab (
 ''select '||rowc||','||colc||','||cellc||' from '||esquema||'.'||tabla||' where n_carga_archivo='||idtipoarchivo||' and n_activo = 1 group by n_fila, c_clave, c_valor order by 1'',
 ''select distinct '||colc||' from '||esquema||'.'||tabla||' where n_carga_archivo='||idtipoarchivo||' and n_activo = 1 order by 1''
 )
 as newtable (
 '||rowc||' varchar,'||columnlist||'
 );';
    return dynsql2;
end
$function$
 ;]]></string>
		</function>
		<function name="fn_incrementar_secuencia_anual" id="f60e7917-3df9-461e-bcec-0b87101580aa" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_incrementar_secuencia_anual()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE
    nuevo_contador INT;
    anio_actual INT := EXTRACT(YEAR FROM CURRENT_DATE); 
    prefijo VARCHAR; 
BEGIN
    NEW.n_anio := anio_actual;
    SELECT n_contador INTO nuevo_contador
    FROM tab_contador_tipo_solicitud
    WHERE n_tipo_solicitud = NEW.n_tipo_solicitud AND n_anio = anio_actual;
    IF NOT FOUND THEN
        INSERT INTO tab_contador_tipo_solicitud (n_tipo_solicitud, n_anio, n_contador)
        VALUES (NEW.n_tipo_solicitud, anio_actual, 1)
        RETURNING n_contador INTO nuevo_contador;
    ELSE
        UPDATE tab_contador_tipo_solicitud
        SET n_contador = n_contador + 1
        WHERE n_tipo_solicitud = NEW.n_tipo_solicitud AND n_anio = anio_actual
        RETURNING n_contador INTO nuevo_contador;
    END IF;
    NEW.n_secuencia = nuevo_contador;
    CASE NEW.n_tipo_solicitud
        WHEN 1 THEN prefijo := 'SPER-';
        WHEN 2 THEN prefijo := 'SPROV-';
        WHEN 3 THEN prefijo := 'SCOM-';
        WHEN 4 THEN prefijo := 'SJE-';
        WHEN 5 THEN prefijo := 'SVIS-';
        WHEN 6 THEN prefijo := 'SEV-';
        ELSE
            RAISE EXCEPTION 'Tipo de solicitud no válido: %', NEW.n_tipo_solicitud;
    END CASE;
    IF NEW.n_secuencia <= 99999 THEN
        NEW.c_correlativo := prefijo || 
							LPAD(NEW.n_secuencia::TEXT, 5, '0') || 
							--'-' || NEW.n_secuencia || 
							'-' || NEW.n_anio;
    ELSE
        NEW.c_correlativo := prefijo || NEW.n_secuencia || '-' || NEW.n_secuencia || '-' || NEW.n_anio;
    END IF;
    RETURN NEW;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_denegado" id="ed977999-8880-4840-85b5-c4d4fe15fcd2" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_denegado(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_denegado_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, c_oficina character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, c_observaciones text, n_estado_acceso integer, c_estado_acceso character varying, c_tipo_solicitud character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
   	SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_denegado_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            tps.c_nombres_apellidos,            
			tcap.n_sede n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso,  
            tcap.c_oficina AS c_oficina,
			muo.n_gerencia,
            COALESCE(muo.c_gerencia, 'SIN INFORMACIÃ“N')c_gerencia,
			muo.n_subgerencia,
			COALESCE(muo.c_subgerencia, 'SIN INFORMACIÃ“N')c_subgerencia,
            a1.c_observaciones,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso,               
			COALESCE(dce2.c_nombre,dce4.c_nombre, 'SIN INFORMACIÃ“N')  AS c_tipo_solicitud	  
        FROM (
            SELECT MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso, 			
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos, tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones,
				   DATE_TRUNC('minute',tcap.d_hora_acceso) d_hora_acceso
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_estado_acceso in (3) 
            GROUP BY tcap.c_numero_documento, tcap.n_tipo_documento, DATE(tcap.d_fecha_acceso) , n_sede,DATE_TRUNC('minute',tcap.d_hora_acceso)	
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
		INNER JOIN (SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento,tpcc.n_tipo_documento                  
				    from tab_personal_cas_cap tpcc 				                      
				            UNION             
				    SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento,tpcc.n_tipo_documento                   
				    from tab_personal_servicio tpcc 				          
					) tps ON tps.c_numero_documento = tcap.c_numero_documento  and tps.n_tipo_documento = tcap.n_tipo_documento
		LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
					) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
		LEFT JOIN det_catalogo_estructura dce2 ON dce2.n_codigo = tcap.n_tipo_solicitud AND dce2.c_columna = 'N_TIPO_SOLICITUD' 
        LEFT JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_contrato AND dce4.c_columna = 'N_TIPO_CONTRATO'     
    	) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))                 
			AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_equipo_vehiculo" id="f5caa5e1-04ce-435b-9bc9-40bc0ec3eefb" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_equipo_vehiculo(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, busquedaserieplaca text DEFAULT NULL::text, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tipoequipovehiculo integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_equipo_vehiculo_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, c_tipo_solicitud character varying, c_tipo_contrato character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, n_tipo_equipo_vehiculo_clasificado integer, c_tipo_equipo_vehiculo_clasificado character varying, c_serie_placa character varying, c_tipo_equipo_vehiculo text, c_marca text, c_modelo text, c_color text, c_numero_estacionamiento integer, n_estado_acceso integer, c_estado_acceso text)
 LANGUAGE plpgsql
AS $function$
BEGIN
    RETURN QUERY
   select *   from (
    SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_equipo_vehiculo_pk,
        a11.c_tipo_documento,
        a11.c_numero_documento,
        a11.c_nombres_apellidos,
        a11.n_cod_sede,
        a11.c_sede,
		a11.n_gerencia,
        a11.c_gerencia,
		a11.n_subgerencia,
        a11.c_subgerencia,	
        a11.c_tipo_solicitud,
		a11.c_tipo_contrato,
        a10.d_fecha_acceso,
        a10.d_hora_minima_acceso,
        a10.d_hora_maxima_acceso,
		a10.n_tipo_equipo_vehiculo_clasificado,
        a10.c_tipo_equipo_vehiculo_clasificado,
        a10.c_serie_placa,
        a10.c_tipo_equipo_vehiculo,
        a10.c_marca,
        a10.c_modelo,
        a10.c_color,
		a10.c_numero_estacionamiento,
		a10.n_estado_acceso,
		a10.c_estado_acceso
    FROM (
		SELECT a1.n_control_acceso_personal,
				a1.c_numero_documento,a1.n_tipo_documento, a1.d_fecha_acceso,a1.d_hora_minima_acceso, a1.d_hora_maxima_acceso,
				a1.c_serie_placa::varchar,a1.c_tipo_equipo_vehiculo,
				a1.c_marca,a1.c_modelo,a1.c_color,a1.c_numero_estacionamiento,a1.n_tipo_equipo_vehiculo_clasificado,dce2.c_nombre c_tipo_equipo_vehiculo_clasificado,
				a1.n_estado_acceso, a1.c_estado_acceso
		FROM (
        SELECT 
            max(dcaev.n_control_acceso_personal) n_control_acceso_personal,
            max(tcap.c_numero_documento)  c_numero_documento,
            max(tcap.n_tipo_documento) n_tipo_documento,
            TO_CHAR(dcaev.d_fecha_acceso, 'DD/MM/YYYY') AS d_fecha_acceso,
            TO_CHAR(MIN(dcaev.d_hora_acceso), 'HH24:MI') AS d_hora_minima_acceso,
            TO_CHAR(CASE WHEN COUNT(dcaev.d_hora_acceso) > 1 THEN MAX(dcaev.d_hora_acceso) ELSE NULL END, 'HH24:MI') AS d_hora_maxima_acceso,
            MAX(te.c_serie) AS c_serie_placa,			
            MAX(dce1.c_nombre) AS c_tipo_equipo_vehiculo, 
            MAX(te.c_marca) AS c_marca, 
            MAX(te.c_modelo) AS c_modelo, 
            MAX(te.c_color) AS c_color,
			NULL::integer c_numero_estacionamiento,
			1 n_tipo_equipo_vehiculo_clasificado,
			MAX(dcaev.n_estado_acceso) as n_estado_acceso,
			max(dce4.c_nombre) as c_estado_acceso,
			max(case when te.c_serie = 'SIN SERIE' then n_equipo_pk::varchar else te.c_serie end) c_serie_placa_agrupacion
        FROM det_control_acceso_equipo_vehiculo dcaev
        INNER JOIN det_solicitud_equipo_vehiculo dsev ON dsev.n_det_solicitud_equipo_vehiculo_pk = dcaev.n_det_solicitud_equipo_vehiculo
        INNER JOIN tab_equipo te ON te.n_equipo_pk = dsev.n_equipo 
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = te.n_tipo_equipo AND dce1.c_columna = 'N_TIPO_EQUIPO'
        inner join tab_control_acceso_personal tcap on tcap.n_control_acceso_personal_pk = dcaev.n_control_acceso_personal
        inner join det_catalogo_estructura dce4 ON dce4.n_codigo = dcaev.n_estado_acceso AND dce4.c_columna = 'N_ESTADO_ACCESO'
        WHERE dsev.n_equipo IS NOT NULL --and te.c_serie = 'SIN SERIE'
        GROUP BY --dcaev.n_control_acceso_personal, 
        		tcap.c_numero_documento,
        		tcap.n_tipo_documento,
        		dcaev.d_fecha_acceso, 
			    --te.c_serie  ,
				case when te.c_serie = 'SIN SERIE' then n_equipo_pk::varchar else te.c_serie end
		) a1 inner join det_catalogo_estructura dce2 ON dce2.n_codigo = a1.n_tipo_equipo_vehiculo_clasificado AND dce2.c_columna = 'N_TIPO_EQUIPO_VEHICULO_CLASIFICADO'
        UNION
	SELECT a1.n_control_acceso_personal,
			a1.c_numero_documento,a1.n_tipo_documento, a1.d_fecha_acceso,a1.d_hora_minima_acceso, a1.d_hora_maxima_acceso,a1.c_serie_placa,a1.c_tipo_equipo_vehiculo,
				a1.c_marca,a1.c_modelo,a1.c_color,a1.c_numero_estacionamiento,a1.n_tipo_equipo_vehiculo_clasificado,dce2.c_nombre c_tipo_equipo_vehiculo_clasificado,
				a1.n_estado_acceso, a1.c_estado_acceso
	FROM (
        SELECT 
            max(dcaev.n_control_acceso_personal) n_control_acceso_personal,
        	max(tcap.c_numero_documento)  c_numero_documento,
        	max(tcap.n_tipo_documento) n_tipo_documento,
            TO_CHAR(dcaev.d_fecha_acceso, 'DD/MM/YYYY') AS d_fecha_acceso,
            TO_CHAR(MIN(dcaev.d_hora_acceso), 'HH24:MI') AS d_hora_minima_acceso,
            TO_CHAR(CASE WHEN COUNT(dcaev.d_hora_acceso) > 1 THEN MAX(dcaev.d_hora_acceso) ELSE NULL END, 'HH24:MI') AS d_hora_maxima_acceso,
            te.c_placa AS c_serie_placa,
            MAX(dce1.c_nombre) AS c_tipo_equipo_vehiculo, 
            MAX(te.c_marca) AS c_marca, 
            MAX(te.c_modelo) AS c_modelo, 
            MAX(te.c_color) AS c_color,
			MAX(dsev.n_numero_estacionamiento) AS c_numero_estacionamiento,
			2 n_tipo_equipo_vehiculo_clasificado,
			MAX(dcaev.n_estado_acceso) as n_estado_acceso,
			max(dce4.c_nombre) as c_estado_acceso
        FROM det_control_acceso_equipo_vehiculo dcaev
        INNER JOIN det_solicitud_equipo_vehiculo dsev ON dsev.n_det_solicitud_equipo_vehiculo_pk = dcaev.n_det_solicitud_equipo_vehiculo
        INNER JOIN tab_vehiculo te ON te.n_vehiculo_pk = dsev.n_vehiculo 
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = te.n_tipo_vehiculo AND dce1.c_columna = 'N_TIPO_VEHICULO'	
        inner join tab_control_acceso_personal tcap on tcap.n_control_acceso_personal_pk = dcaev.n_control_acceso_personal
        inner join det_catalogo_estructura dce4 ON dce4.n_codigo = dcaev.n_estado_acceso AND dce4.c_columna = 'N_ESTADO_ACCESO'
        WHERE dsev.n_vehiculo IS NOT NULL
        GROUP BY --dcaev.n_control_acceso_personal,
        		 tcap.c_numero_documento,
        		 tcap.n_tipo_documento,
        		 dcaev.d_fecha_acceso, te.c_placa
		) a1 inner join det_catalogo_estructura dce2 ON dce2.n_codigo = a1.n_tipo_equipo_vehiculo_clasificado AND dce2.c_columna = 'N_TIPO_EQUIPO_VEHICULO_CLASIFICADO'
    ) a10
    INNER JOIN (
        SELECT 
            tcap.n_control_acceso_personal_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            tps.c_nombres_apellidos, 
            tcap.n_sede n_cod_sede,
            dce3.c_nombre AS c_sede,
			muo.n_gerencia,
            muo.c_gerencia AS c_gerencia,
			muo.n_subgerencia,
            muo.c_subgerencia AS c_subgerencia,
            dce2.c_nombre AS c_tipo_solicitud,
			dce4.c_nombre AS c_tipo_contrato
        FROM tab_control_acceso_personal tcap 
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
        INNER JOIN (
            SELECT 
                CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno, ''), ' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos,
                tpcc.c_numero_documento ,  tpcc.n_tipo_documento                
            FROM tab_personal_cas_cap tpcc
            UNION             
            SELECT 
                CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno, ''), ' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos,
                tpcc.c_numero_documento    ,  tpcc.n_tipo_documento               
            FROM tab_personal_servicio tpcc
        ) tps ON tps.c_numero_documento = tcap.c_numero_documento and  tps.n_tipo_documento = tcap.n_tipo_documento
        LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1  
				   ) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
        LEFT JOIN det_catalogo_estructura dce2 ON dce2.n_codigo = tcap.n_tipo_solicitud AND dce2.c_columna = 'N_TIPO_SOLICITUD' 
        LEFT JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_contrato AND dce4.c_columna = 'N_TIPO_CONTRATO' 
    	WHERE tcap.n_tipo_solicitud IS NOT NULL OR tcap.n_tipo_contrato IS NOT NULL
	) a11 ON a11.n_control_acceso_personal_pk = a10.n_control_acceso_personal
    )a12
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a12.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (
			    busquedaPersona IS NULL 
			    OR a12.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a12.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
    	  AND (busquedaSeriePlaca IS NULL OR a12.c_serie_placa ILIKE '%' || busquedaSeriePlaca || '%') 	  
		  AND (gerencia IS NULL OR a12.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a12.n_subgerencia = subGerencia)
		  AND (sede IS NULL OR a12.n_cod_sede = sede)	 
 		  AND (tipoEquipoVehiculo IS NULL OR a12.n_tipo_equipo_vehiculo_clasificado = tipoEquipoVehiculo)
		  ORDER BY TO_DATE(a12.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a12.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_extraordinario" id="0011b294-1c50-4494-96a1-8bfb8921232a" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_extraordinario(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, tiposolicitud integer DEFAULT NULL::integer, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_extraordinario_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_estado_acceso integer, c_estado_acceso character varying, n_tipo_solicitud integer, c_tipo_solicitud character varying, c_observaciones text)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
       	SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_extraordinario_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            tps.c_nombres_apellidos,
          	tcap.n_sede AS n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso,  
			muo.n_gerencia,
            muo.c_gerencia,
			muo.n_subgerencia,
			muo.c_subgerencia,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso,
			tcap.n_tipo_solicitud,
			dce4.c_nombre c_tipo_solicitud,
			a1.c_observaciones                
        FROM (
            SELECT 	MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   	MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   	CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL 
					WHEN MAX(tcap.n_estado_acceso) = 3 THEN null
					ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso,    
                   	DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos, tcap.n_tipo_documento,
					STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_tipo_solicitud in(3,4,5) and tcap.n_estado_acceso in (1,2)
            GROUP BY c_numero_documentos,n_tipo_documento, d_fecha_accesos, n_sede			
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
        INNER JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1
				   ) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
        INNER JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_solicitud AND dce4.c_columna = 'N_TIPO_SOLICITUD'
        INNER JOIN (SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, 
        							tpcc.c_numero_documento ,tpcc.n_tipo_documento                   
				    from tab_personal_cas_cap tpcc 				                      
				            UNION             
				    SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos,
				                   tpcc.c_numero_documento ,tpcc.n_tipo_documento                   
				    from tab_personal_servicio tpcc 				          
					) tps ON tps.c_numero_documento = tcap.c_numero_documento   and tps.n_tipo_documento = tcap.n_tipo_documento  
    ) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))               
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
          AND (tipoSolicitud IS NULL OR a10.n_tipo_solicitud = tipoSolicitud)
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_general" id="c4e830c2-50dc-4e3b-8aa7-67a7b05ccd0d" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_general(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_general_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, c_oficina character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, c_observaciones text, n_estado_acceso integer, c_estado_acceso character varying, c_tipo_solicitud character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
      SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_general_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            tps.c_nombres_apellidos,            
			tcap.n_sede n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso,  
            tcap.c_oficina AS c_oficina,
			muo.n_gerencia,
            COALESCE(muo.c_gerencia, 'SIN INFORMACIÓN')c_gerencia,
			muo.n_subgerencia,
			COALESCE(muo.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia,
            a1.c_observaciones,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso,               
			COALESCE(dce2.c_nombre,dce4.c_nombre, 'SIN INFORMACIÓN')  AS c_tipo_solicitud	  
        FROM (
            SELECT MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL 
						WHEN MAX(tcap.n_estado_acceso) = 3 THEN null
					ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso, 			
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos,tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_estado_acceso in (1,2) 
            GROUP BY c_numero_documentos,n_tipo_documento, d_fecha_accesos, n_sede	
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
		LEFT JOIN (SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, 
									tpcc.c_numero_documento ,tpcc.n_tipo_documento                  
				    from tab_personal_cas_cap tpcc 				                      
				            UNION             
				    SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos,
				                   tpcc.c_numero_documento  ,tpcc.n_tipo_documento                 
				    from tab_personal_servicio tpcc 				          
					) tps ON tps.c_numero_documento = tcap.c_numero_documento  and tps.n_tipo_documento = tcap.n_tipo_documento 
		LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
				   ) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
		LEFT JOIN det_catalogo_estructura dce2 ON dce2.n_codigo = tcap.n_tipo_solicitud AND dce2.c_columna = 'N_TIPO_SOLICITUD' 
        LEFT JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_contrato AND dce4.c_columna = 'N_TIPO_CONTRATO'     
    	) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))                
			AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_no_autorizado" id="0b4e9371-8674-42f7-adcb-640911edc3d6" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_no_autorizado(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedadocumento text DEFAULT NULL::text, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_no_autorizado_pk integer, c_tipo_documento character varying, c_numero_documento character varying, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, c_observaciones text, n_estado_acceso integer, c_estado_acceso character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
 SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_no_autorizado_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento,            
            tcap.n_sede AS n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso, 
            a1.c_observaciones,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso                
        FROM (
            SELECT 
				   MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal,                  
				   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso, 			   	
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos,tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones,
				   DATE_TRUNC('minute',tcap.d_hora_acceso) d_hora_acceso
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_estado_acceso = 4 
            GROUP BY tcap.c_numero_documento, tcap.n_tipo_documento, DATE(tcap.d_fecha_acceso) , n_sede,DATE_TRUNC('minute',tcap.d_hora_acceso)	
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'	    
    	) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))                
          AND (busquedaDocumento IS NULL OR a10.c_numero_documento ILIKE '%' || busquedaDocumento || '%')  
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)		
		 ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_personal" id="220d7e91-6bf0-4148-8738-42ac77731ced" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_personal(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, tipocontrato integer DEFAULT NULL::integer, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_personal_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, c_oficina character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, c_observaciones text, n_estado_acceso integer, c_estado_acceso character varying, n_modalidad_contratacion integer, c_modalidad_contratacion character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
	 SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_personal_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            tps.c_nombres_apellidos,            
			tcap.n_sede AS n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso,  
            tcap.c_oficina AS c_oficina,
			muo.n_gerencia,
            muo.c_gerencia,
			muo.n_subgerencia,
			muo.c_subgerencia,
            a1.c_observaciones,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso, 
			tcap.n_tipo_contrato n_modalidad_contratacion,               
            dce4.c_nombre AS c_modalidad_contratacion  
        FROM (
            SELECT MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL
						WHEN MAX(tcap.n_estado_acceso) = 3 THEN NULL 
					ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso, 			
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos,tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_tipo_solicitud = 1 and tcap.n_estado_acceso in (1,2)
            GROUP BY c_numero_documentos,n_tipo_documento, d_fecha_accesos, n_sede
			union 
			SELECT MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL 
						WHEN MAX(tcap.n_estado_acceso) = 3 THEN NULL 
					ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso,    
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos,tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_personal_cas_cap is not null and tcap.n_tipo_contrato is not null and tcap.n_estado_acceso in (1,2)
            GROUP BY c_numero_documentos,n_tipo_documento, d_fecha_accesos, n_sede
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
        LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1
				   ) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
        INNER JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_contrato AND dce4.c_columna = 'N_TIPO_CONTRATO'
        INNER JOIN (SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, 
        				tpcc.c_numero_documento  ,  tpcc.n_tipo_documento              
				    from tab_personal_cas_cap tpcc 				                      
				            UNION             
				    SELECT CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos,
				                   tpcc.c_numero_documento ,  tpcc.n_tipo_documento                  
				    from tab_personal_servicio tpcc 				          
					) tps ON tps.c_numero_documento = tcap.c_numero_documento and    tps.n_tipo_documento = tcap.n_tipo_documento
    ) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))                
			AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
          AND (tipoContrato IS NULL OR a10.n_modalidad_contratacion = tipoContrato)
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_control_acceso_proveedor" id="e60a32fa-67aa-4759-b09b-46e2d1b9be4f" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_control_acceso_proveedor(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, busquedapersona text DEFAULT NULL::text, tipocontrato integer DEFAULT NULL::integer, tipoprocesocontrato integer DEFAULT NULL::integer, tipoempresa integer DEFAULT NULL::integer, busquedaempresa character varying DEFAULT NULL::character varying, accesosnocontables character varying DEFAULT NULL::character varying, sede integer DEFAULT NULL::integer, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer)
 RETURNS TABLE(n_control_acceso_proveedor_pk integer, c_tipo_documento character varying, c_numero_documento character varying, c_nombres_apellidos text, n_cod_sede integer, c_sede character varying, d_fecha_acceso text, d_hora_minima_acceso text, d_hora_maxima_acceso text, c_oficina character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, c_observaciones text, n_estado_acceso integer, c_estado_acceso character varying, n_modalidad_contratacion integer, c_modalidad_contratacion character varying, n_tipo_proceso integer, c_tipo_proceso character varying, n_tipo_empresa integer, c_tipo_empresa character varying, c_ruc character varying, c_razon_social character varying, c_tipo_documento_coordinador character varying, c_numero_documento_coordinador character varying, c_nombres_apellidos_coordinador text)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
    SELECT  * FROM (
        SELECT ROW_NUMBER() OVER ()::INTEGER AS n_control_acceso_proveedor_pk,
            dce1.c_codigo AS c_tipo_documento,
            tcap.c_numero_documento, 
            CONCAT(COALESCE(tps.c_nombres, ''), ' ', COALESCE(tps.c_apellido_paterno,''),' ',  COALESCE(tps.c_apellido_materno, '')) AS c_nombres_apellidos,            
			tcap.n_sede AS n_cod_sede,
            dce3.c_nombre AS c_sede,
			TO_CHAR(a1.d_fecha_accesos, 'DD/MM/YYYY') AS d_fecha_acceso,
			TO_CHAR(a1.d_hora_minima_acceso, 'HH24:MI') AS d_hora_minima_acceso,
			TO_CHAR(a1.d_hora_maxima_acceso, 'HH24:MI') AS d_hora_maxima_acceso,  
            tcap.c_oficina AS c_oficina,
			muo.n_gerencia,
            muo.c_gerencia ,
			muo.n_subgerencia,
			muo.c_subgerencia ,
            a1.c_observaciones,
			tcap.n_estado_acceso,
            dce.c_nombre AS c_estado_acceso, 
       		tcap.n_tipo_contrato n_modalidad_contratacion,
            dce4.c_nombre AS c_modalidad_contratacion, 
   			tcap.n_tipo_proceso_contrato n_tipo_proceso,
            dce5.c_nombre AS c_tipo_proceso,
			tcap.n_tipo_empresa,
            dce6.c_nombre AS c_tipo_empresa,
            mep.c_ruc,
            mep.c_razon_social,
            coor.c_tipo_documento_coordinador,
            coor.c_numero_documento_coordinador,
            coor.c_nombres_apellidos_coordinador
        FROM (
            SELECT MIN(tcap.n_control_acceso_personal_pk) AS n_control_acceso_personal, 
                   MIN(tcap.d_hora_acceso) AS d_hora_minima_acceso,
                   CASE WHEN MIN(tcap.d_hora_acceso) = MAX(tcap.d_hora_acceso) THEN NULL 
						WHEN MAX(tcap.n_estado_acceso) = 3 THEN NULL
					ELSE MAX(tcap.d_hora_acceso) END AS d_hora_maxima_acceso,    
                   DATE(tcap.d_fecha_acceso) AS d_fecha_accesos, tcap.n_sede, tcap.c_numero_documento AS c_numero_documentos,tcap.n_tipo_documento,
				   STRING_AGG(tcap.c_observaciones, ' \ ' ORDER BY tcap.n_control_acceso_personal_pk) AS c_observaciones
            FROM tab_control_acceso_personal tcap
            WHERE tcap.n_tipo_solicitud = 2 and tcap.n_estado_acceso in (1,2)
            GROUP BY c_numero_documentos,n_tipo_documento, d_fecha_accesos, n_sede
        ) a1
        INNER JOIN tab_control_acceso_personal tcap ON tcap.n_control_acceso_personal_pk = a1.n_control_acceso_personal
        INNER JOIN det_catalogo_estructura dce ON dce.n_codigo = tcap.n_estado_acceso AND dce.c_columna = 'N_ESTADO_ACCESO'
        INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tcap.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        INNER JOIN det_catalogo_estructura dce3 ON dce3.n_codigo = tcap.n_sede AND dce3.c_columna = 'N_SEDE'
        INNER JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1
				   ) muo ON muo.n_unidad_organica_pk = tcap.n_unidad_organica 
        INNER JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = tcap.n_tipo_contrato AND dce4.c_columna = 'N_TIPO_CONTRATO'
        INNER JOIN det_catalogo_estructura dce5 ON dce5.n_codigo = tcap.n_tipo_proceso_contrato AND dce5.c_columna = 'N_TIPO_PROCESO_CONTRATO'
        INNER JOIN det_catalogo_estructura dce6 ON dce6.n_codigo = tcap.n_tipo_empresa AND dce6.c_columna = 'N_TIPO_EMPRESA'
        INNER JOIN tab_personal_servicio tps ON tps.n_personal_servicio_pk = tcap.n_personal_servicio
        INNER JOIN tab_contrato tc ON tc.n_contrato_pk = tcap.n_contrato
        INNER JOIN mae_empresa_proveedor mep ON mep.n_empresa_proveedor_pk = tc.n_empresa_proveedor
        INNER JOIN tab_coordinador tcor ON tcor.n_coordinador_pk = tcap.n_coordinador
        INNER JOIN (
            SELECT n_coordinador_pk AS n_coordinador_pk_2, 
                   CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos_coordinador,
                   tpcc.c_numero_documento AS c_numero_documento_coordinador,
                   dce1.c_codigo AS c_tipo_documento_coordinador
            FROM tab_coordinador tc 
            INNER JOIN tab_personal_cas_cap tpcc ON tpcc.n_personal_cas_cap_pk = tc.n_personal_cas_cap 
            INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tpcc.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
            UNION 
            SELECT n_coordinador_pk, 
                   CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos_coordinador,
                   tpcc.c_numero_documento AS c_numero_documento_coordinador,
                   dce1.c_codigo AS c_tipo_documento_coordinador
            FROM tab_coordinador tc 
            INNER JOIN tab_personal_servicio tpcc ON tpcc.n_personal_servicio_pk = tc.n_personal_servicio 
            INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = tpcc.n_tipo_documento AND dce1.c_columna = 'N_TIPO_DOCUMENTO'
        ) coor ON coor.n_coordinador_pk_2 = tcor.n_coordinador_pk
    ) a10 
    WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))                
          AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  AND (busquedaEmpresa IS NULL OR a10.c_razon_social ILIKE '%' || busquedaEmpresa || '%')
          AND (tipoContrato IS NULL OR a10.n_modalidad_contratacion = tipoContrato)
          AND (tipoProcesoContrato IS NULL OR a10.n_tipo_proceso = tipoProcesoContrato)
          AND (tipoEmpresa IS NULL OR a10.n_tipo_empresa = tipoEmpresa)
		  AND (accesosNoContables IS NULL OR a10.c_estado_acceso = accesosNoContables)
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)	 
		  ORDER BY TO_DATE(a10.d_fecha_acceso, 'DD/MM/YYYY') DESC, TO_TIMESTAMP(a10.d_hora_minima_acceso, 'HH24:MI') DESC;
END;
$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_solicitud_equipo_vehiculo_detalle" id="7bf61abb-92ee-4af0-bb88-76a1ede8d359" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_solicitud_equipo_vehiculo_detalle(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tipoequipovehiculo integer DEFAULT NULL::integer, estadosolicitud integer DEFAULT NULL::integer, estadovigencia integer DEFAULT NULL::integer, busquedapersona text DEFAULT NULL::text)
 RETURNS TABLE(n_solicitud_detalle_equipo_vehiculo_detalle_pk integer, n_solicitud_equipo_vehiculo_pk integer, n_cod_sede integer, c_sede character varying, d_fecha_inicio_acceso text, d_fecha_fin_acceso text, n_estado_solicitud_detalle integer, c_estado_solicitud_detalle character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_tipo_equipo_vehiculo_clasificado integer, c_tipo_equipo_vehiculo_clasificado character varying, n_tipo_equipo_vehiculo integer, c_tipo_equipo_vehiculo character varying, n_vigente integer, c_vigente text, n_estado_solicitud integer, c_estado_solicitud character varying, d_aud_fecha_creacion text, c_correlativo character varying, c_numero_documento character varying, c_nombres_apellidos text, n_tipo_documento integer, c_tipo_documento character varying, n_numero_estacionamiento integer, c_marca character varying, c_modelo character varying, c_color character varying, c_serie_placa character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
    select * from (
   select ROW_NUMBER() OVER ()::INTEGER AS n_solicitud_detalle_equipo_vehiculo_detalle_pk,
		csev.n_solicitud_equipo_vehiculo_pk,
   		COALESCE(detper.n_sede,detper2.n_sede) as n_cod_sede, 
		COALESCE(detper.c_sede,detper2.c_sede) as c_sede,			
		TO_CHAR(dsev.d_fecha_inicio_acceso, 'DD/MM/YYYY')d_fecha_inicio_acceso,
		TO_CHAR(dsev.d_fecha_fin_acceso, 'DD/MM/YYYY')d_fecha_fin_acceso,				
		dsev.n_estado_solicitud_detalle,
		dce5.c_nombre C_estado_solicitud_detalle,	
		COALESCE(detper.n_gerencia,detper2.n_gerencia) as n_gerencia,
		COALESCE(detper.c_gerencia,detper2.c_gerencia, 'SIN INFORMACIÓN') as c_gerencia,
		COALESCE(detper.n_subgerencia,detper2.n_subgerencia)as n_subgerencia,
		COALESCE(detper.c_subgerencia,detper2.c_subgerencia, 'SIN INFORMACIÓN') as c_subgerencia,
		COALESCE(equi.n_tipo_equipo_clasificado,vehi.n_tipo_vehiculo_clasificado) as n_tipo_equipo_vehiculo_clasificado,
		COALESCE(equi.c_tipo_equipo_clasificado,vehi.c_tipo_vehiculo_clasificado) as c_tipo_equipo_vehiculo_clasificado,		
		COALESCE(equi.n_tipo_equipo,vehi.n_tipo_vehiculo) as n_tipo_equipo_vehiculo,
		COALESCE(equi.c_tipo_equipo,vehi.c_tipo_vehiculo) as c_tipo_equipo_vehiculo,
		--dsev.n_activo::integer,
		dsev.n_vigente::integer,
		case when dsev.n_vigente= 1 then 'Vigente' else 'No Vigente' end c_vigente,
		tse.n_estado_solicitud,
		dce8.c_nombre c_estado_solicitud ,
		TO_CHAR(csev.d_aud_fecha_creacion, 'DD/MM/YYYY')d_aud_fecha_creacion,
		csev.c_correlativo,		
		personal1.c_numero_documento,
		personal1.c_nombres_apellidos,
		personal1.n_tipo_documento,
		personal1.c_tipo_documento,
		dsev.n_numero_estacionamiento,
		COALESCE(equi.c_marca_e, vehi.c_marca_v) as c_marca,
		COALESCE(equi.c_modelo_e, vehi.c_modelo_v) as c_modelo,
		COALESCE(equi.c_color_e, vehi.c_color_v) as c_color,
		COALESCE(equi.c_serie_e, vehi.c_placa_v) as c_serie_placa
   from cab_solicitud_equipo_vehiculo csev
   INNER JOIN tab_solicitud_evaluacion tse on tse.n_solicitud_equipo_vehiculo =  csev.n_solicitud_equipo_vehiculo_pk and tse.n_activo=1
   inner join det_catalogo_estructura dce8 ON dce8.n_codigo = tse.n_estado_solicitud AND dce8.c_columna = 'N_ESTADO_SOLICITUD'  --and dce8.n_activo=1
   inner join det_solicitud_equipo_vehiculo dsev on dsev.n_solicitud_equipo_vehiculo = csev.n_solicitud_equipo_vehiculo_pk and dsev.n_activo=1
   inner join (SELECT dpc.n_det_solicitud_equipo_vehiculo_pk ,CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento , tpcc.n_tipo_documento ,  dce5.c_codigo c_tipo_documento             
				    from tab_personal_cas_cap tpcc 
				    inner join det_solicitud_equipo_vehiculo dpc on dpc.n_personal_cas_cap = tpcc.n_personal_cas_cap_pk 
				    inner join det_catalogo_estructura dce5 ON dce5.n_codigo = tpcc.n_tipo_documento AND dce5.c_columna = 'N_TIPO_DOCUMENTO' --and dce5.n_activo=1 
				            UNION  
					select 	 dsev.n_det_solicitud_equipo_vehiculo_pk , CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento , tpcc.n_tipo_documento, dce5.c_codigo c_tipo_documento                   
					from det_solicitud_equipo_vehiculo dsev
					inner join det_solicitud_personal dsp on dsp.n_det_solicitud_personal_pk = dsev.n_det_solicitud_personal 
					inner join det_personal_contrato dpc on dpc.n_det_personal_contrato_pk = dsp.n_det_personal_contrato 
				    inner join tab_personal_servicio tpcc on tpcc.n_personal_servicio_pk = dpc.n_personal_servicio and tpcc.n_activo =1
				    inner join det_catalogo_estructura dce5 ON dce5.n_codigo = tpcc.n_tipo_documento AND dce5.c_columna = 'N_TIPO_DOCUMENTO' --and dce5.n_activo=1 
   				) personal1 on personal1.n_det_solicitud_equipo_vehiculo_pk = dsev.n_det_solicitud_equipo_vehiculo_pk
   inner join det_catalogo_estructura dce5 ON dce5.n_codigo = dsev.n_estado_solicitud_detalle AND dce5.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' --and dce5.n_activo=1
   left join (select n_det_solicitud_personal_pk,dsp.n_sede, dce1.c_nombre c_sede, muo.n_gerencia,muo.c_gerencia,muo.n_subgerencia,muo.c_subgerencia
		       from det_solicitud_personal dsp 
		       inner join det_catalogo_estructura dce1 ON dce1.n_codigo = dsp.n_sede AND dce1.c_columna = 'N_SEDE' and dce1.n_activo=1
		       LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
								CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
								CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
								CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
	    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
							FROM mae_unidad_organica uo
							LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
							where uo.n_activo = 1 
						 ) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
   					) detper on detper.n_det_solicitud_personal_pk= dsev.n_det_solicitud_personal
     left join (select n_personal_cas_cap_pk,dsp.n_sede, dce1.c_nombre c_sede, muo.n_gerencia,muo.c_gerencia,muo.n_subgerencia,muo.c_subgerencia
			       from tab_personal_cas_cap dsp 
			       inner join det_catalogo_estructura dce1 ON dce1.n_codigo = dsp.n_sede AND dce1.c_columna = 'N_SEDE'
			       LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
										CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
										CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
										CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
			    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
								FROM mae_unidad_organica uo
								LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
								where uo.n_activo = 1 
							   ) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
       				)detper2 on detper2.n_personal_cas_cap_pk = dsev.n_personal_cas_cap
      left join (select n_equipo_pk, n_tipo_equipo, c_tipo_equipo, n_tipo_equipo_clasificado, dce2.c_nombre c_tipo_equipo_clasificado 
      					,c_marca_e,c_modelo_e,c_color_e,c_serie_e
      					from (  select n_equipo_pk,	te.n_tipo_equipo,dce1.c_nombre c_tipo_equipo, 1 n_tipo_equipo_clasificado
      							,te.c_marca c_marca_e, te.c_modelo c_modelo_e, te.c_color c_color_e, te.c_serie c_serie_e
						        from tab_equipo te 
						        inner join det_catalogo_estructura dce1 ON dce1.n_codigo = te.n_tipo_equipo AND dce1.c_columna = 'N_TIPO_EQUIPO' --and dce1.n_activo=1
								where te.n_activo=1
			      			 ) a1
			        	inner join det_catalogo_estructura dce2 ON dce2.n_codigo = a1.n_tipo_equipo_clasificado AND dce2.c_columna = 'N_TIPO_EQUIPO_VEHICULO_CLASIFICADO' --and dce2.n_activo=1
			      ) equi on equi.n_equipo_pk = 	dsev.n_equipo			
	   left join (select n_vehiculo_pk, n_tipo_vehiculo, c_tipo_vehiculo,	n_tipo_vehiculo_clasificado, dce2.c_nombre c_tipo_vehiculo_clasificado 
	   					 ,c_marca_v, c_modelo_v, c_color_v, c_placa_v
	   						from (select n_vehiculo_pk,tv.n_tipo_vehiculo, dce1.c_nombre c_tipo_vehiculo, 2 n_tipo_vehiculo_clasificado
	   							  ,tv.c_marca c_marca_v , tv.c_modelo c_modelo_v, tv.c_color c_color_v, tv.c_placa c_placa_v
			        			  from tab_vehiculo tv 
			        			  inner join det_catalogo_estructura dce1 ON dce1.n_codigo = tv.n_tipo_vehiculo AND dce1.c_columna = 'N_TIPO_VEHICULO' --and dce1.n_activo=1
								  where tv.n_activo=1
			     			     ) a1			
			       			inner join det_catalogo_estructura dce2 ON dce2.n_codigo = a1.n_tipo_vehiculo_clasificado AND dce2.c_columna = 'N_TIPO_EQUIPO_VEHICULO_CLASIFICADO' --and dce2.n_activo=1
	   			 )vehi on vehi.n_vehiculo_pk = 	dsev.n_vehiculo
		where csev.n_activo=1
	   	) a10
       	WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_aud_fecha_creacion, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subgerencia IS NULL OR a10.n_subgerencia = subgerencia)		
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (tipoequipovehiculo IS NULL OR a10.n_tipo_equipo_vehiculo_clasificado = tipoequipovehiculo)
		  AND (estadoSolicitud IS NULL OR a10.n_estado_solicitud = estadoSolicitud)
		  AND (estadoVigencia IS NULL OR a10.n_vigente = estadoVigencia)
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  ORDER BY a10.n_solicitud_equipo_vehiculo_pk desc, TO_DATE(a10.d_fecha_inicio_acceso, 'DD/MM/YYYY') DESC;
	END;
	$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_solicitud_extraordinario_detalle" id="add8ea4c-ee58-49de-8286-194a64cfd0d6" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_solicitud_extraordinario_detalle(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tiposolicitud integer DEFAULT NULL::integer, estadosolicitud integer DEFAULT NULL::integer, estadovigencia integer DEFAULT NULL::integer, busquedapersona text DEFAULT NULL::text)
 RETURNS TABLE(n_solicitud_extraordinario_detalle_pk integer, n_solicitud_pk integer, n_cod_sede integer, c_sede character varying, d_fecha_inicio_acceso text, d_fecha_fin_acceso text, n_estado_solicitud_detalle integer, c_estado_solicitud_detalle character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_tipo_solicitud integer, c_tipo_solicitud character varying, n_vigente integer, c_vigente text, n_estado_solicitud integer, c_estado_solicitud character varying, d_aud_fecha_creacion text, c_correlativo character varying, c_motivo character varying, c_numero_documento character varying, c_nombres_apellidos text, n_tipo_documento integer, c_tipo_documento character varying, d_hora_ingreso text, d_hora_salida text, n_det_personal_contrato_pk integer)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
    	select * from (
		select  ROW_NUMBER() OVER ()::INTEGER AS n_solicitud_extraordinario_detalle_pk,
				cs.n_solicitud_pk,		
				dsp.n_sede n_cod_sede, 
				dce4.c_nombre c_sede,			
				TO_CHAR(dsp.d_fecha_inicio_acceso, 'DD/MM/YYYY')d_fecha_inicio_acceso,
				TO_CHAR(dsp.d_fecha_fin_acceso, 'DD/MM/YYYY')d_fecha_fin_acceso,				
				dsp.n_estado_solicitud_detalle,
				dce5.c_nombre c_estado_solicitud_detalle,
				muo.n_gerencia,
            	COALESCE(muo.c_gerencia, 'SIN INFORMACIÓN')c_gerencia,
				muo.n_subgerencia,
				COALESCE(muo.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia,
				cs.n_tipo_solicitud, 
				dce1.c_nombre c_tipo_solicitud,
				--COALESCE(tc.n_tipo_contrato,depercon.n_tipo_contrato) n_tipo_contrato,
				--COALESCE(tc.c_tipo_contrato,depercon.c_tipo_contrato,dce1.c_nombre )c_tipo_contrato,
				dsp.n_vigente::integer,
				case when dsp.n_vigente= 1 then 'Vigente' else 'No Vigente' end c_vigente,
				tse.n_estado_solicitud,
				dce8.c_nombre c_estado_solicitud,
				TO_CHAR(cs.d_aud_fecha_creacion, 'DD/MM/YYYY')d_aud_fecha_creacion,
				cs.c_correlativo,
				dsp.c_motivo,
				personal1.c_numero_documento,
				personal1.c_nombres_apellidos,
				personal1.n_tipo_documento,
				personal1.c_tipo_documento,
				TO_CHAR(dsp.d_hora_ingreso, 'HH24:MI') AS d_hora_ingreso,
				TO_CHAR(dsp.d_hora_salida, 'HH24:MI') AS d_hora_salida,
				personal1.n_det_personal_contrato_pk
		from cab_solicitud cs 
		INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = cs.n_tipo_solicitud AND dce1.c_columna = 'N_TIPO_SOLICITUD' --and dce1.n_activo=1
		INNER JOIN tab_solicitud_evaluacion tse on tse.n_solicitud =  cs.n_solicitud_pk and tse.n_activo=1
		inner join det_catalogo_estructura dce8 ON dce8.n_codigo = tse.n_estado_solicitud AND dce8.c_columna = 'N_ESTADO_SOLICITUD' --and dce8.n_activo=1
		inner join det_solicitud_contrato dsc on dsc.n_solicitud = cs.n_solicitud_pk and dsc.n_activo=1	
		inner join det_personal_contrato dpc on dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1
		inner join (SELECT dpc.n_det_personal_contrato_pk ,CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento , tpcc.n_tipo_documento ,  dce5.c_codigo c_tipo_documento             
				    from tab_personal_cas_cap tpcc 
				    inner join det_personal_contrato dpc on dpc.n_personal_cas_cap = tpcc.n_personal_cas_cap_pk 
				    inner join det_catalogo_estructura dce5 ON dce5.n_codigo = tpcc.n_tipo_documento AND dce5.c_columna = 'N_TIPO_DOCUMENTO' --and dce5.n_activo=1 
				            UNION             
				    SELECT dpc.n_det_personal_contrato_pk , CONCAT(COALESCE(tpcc.c_nombres, ''), ' ', COALESCE(tpcc.c_apellido_paterno,''),' ', COALESCE(tpcc.c_apellido_materno, '')) AS c_nombres_apellidos, tpcc.c_numero_documento , tpcc.n_tipo_documento, dce5.c_codigo c_tipo_documento                   
				    from tab_personal_servicio tpcc 
				    inner join det_personal_contrato dpc on dpc.n_personal_servicio = tpcc.n_personal_servicio_pk 
				    inner join det_catalogo_estructura dce5 ON dce5.n_codigo = tpcc.n_tipo_documento AND dce5.c_columna = 'N_TIPO_DOCUMENTO' --and dce5.n_activo=1 
					) personal1 on personal1.n_det_personal_contrato_pk = dpc.n_det_personal_contrato_pk
		inner join det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and dsp.n_activo=1
		INNER JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = dsp.n_sede AND dce4.c_columna = 'N_SEDE' and dce4.n_activo=1
		inner join det_catalogo_estructura dce5 ON dce5.n_codigo = dsp.n_estado_solicitud_detalle AND dce5.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' --and dce5.n_activo=1
		LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
				   ) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
		where cs.n_activo=1 and cs.n_tipo_solicitud in (3,4,5)
		) a10
		 WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_aud_fecha_creacion, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)		
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (tipoSolicitud IS NULL OR a10.n_tipo_solicitud = tipoSolicitud)
		  AND (estadoSolicitud IS NULL OR a10.n_estado_solicitud = estadoSolicitud)
		  AND (estadoVigencia IS NULL OR a10.n_vigente = estadoVigencia)
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  ORDER BY n_solicitud_pk desc , TO_DATE(a10.d_fecha_inicio_acceso, 'DD/MM/YYYY') DESC;
	END;
	$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_solicitud_persona_detalle" id="061e1fa5-a7ea-4bd5-b6cd-637620d67dcd" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_solicitud_persona_detalle(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tiposolicitud integer DEFAULT NULL::integer, estadosolicitud integer DEFAULT NULL::integer, estadovigencia integer DEFAULT NULL::integer, busquedapersona text DEFAULT NULL::text)
 RETURNS TABLE(n_solicitud_persona_detalle_pk integer, n_solicitud_pk integer, n_cod_sede integer, c_sede character varying, d_fecha_inicio_acceso text, d_fecha_fin_acceso text, n_estado_solicitud_detalle integer, c_estado_solicitud_detalle character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_tipo_solicitud integer, c_tipo_solicitud character varying, n_tipo_contrato integer, c_tipo_contrato character varying, n_vigente integer, c_vigente text, n_estado_solicitud integer, c_estado_solicitud character varying, d_aud_fecha_creacion text, c_nombres_apellidos text, c_numero_documento character varying, n_tipo_documento integer, c_tipo_documento character varying, c_correo_electronico character varying, c_telefono character varying, d_hora_ingreso text, d_hora_salida text, c_oficina character varying, d_fecha_inicio_contrato text, d_fecha_fin_contrato text, n_tipo_proceso_contrato integer, c_tipo_proceso_contrato character varying, c_correlativo character varying, c_numero_contrato character varying, c_nombre_contrato character varying, c_ruc character varying, c_razon_social character varying, n_tipo_empresa integer, c_tipo_empresa character varying, n_cod_sede_acceso integer, c_sede_acceso character varying, n_gerencia_acceso integer, c_gerencia_acceso character varying, n_subgerencia_acceso integer, c_subgerencia_acceso character varying, n_proceso_electoral integer, c_tipo_proceso_electoral character varying, n_det_personal_contrato_pk integer)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
select * from (
		select  ROW_NUMBER() OVER ()::INTEGER AS n_solicitud_persona_detalle_pk,
				cs.n_solicitud_pk,		
				tc.n_sede n_cod_sede, 
				tc.c_sede,			
				TO_CHAR(dsp.d_fecha_inicio_acceso, 'DD/MM/YYYY')d_fecha_inicio_acceso,
				TO_CHAR(dsp.d_fecha_fin_acceso, 'DD/MM/YYYY')d_fecha_fin_acceso,				
				dsp.n_estado_solicitud_detalle,
				dce5.c_nombre c_estado_solicitud_detalle,
				tc.n_gerencia,
            	COALESCE(tc.c_gerencia, 'SIN INFORMACIÓN')c_gerencia,
				tc.n_subgerencia,
				COALESCE(tc.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia,
				cs.n_tipo_solicitud, 
				dce1.c_nombre c_tipo_solicitud,
				tc.n_tipo_contrato,
				tc.c_tipo_contrato ,
				dsp.n_vigente::integer,
				case when dsp.n_vigente= 1 then 'Vigente' else 'No Vigente' end c_vigente,
				tse.n_estado_solicitud,
				dce8.c_nombre c_estado_solicitud,
				TO_CHAR(cs.d_aud_fecha_creacion, 'DD/MM/YYYY')d_aud_fecha_creacion,
				CONCAT(COALESCE(tpc.c_nombres, ''), ' ', COALESCE(tpc.c_apellido_paterno,''),' ', COALESCE(tpc.c_apellido_materno, '')) AS c_nombres_apellidos, 
				tpc.c_numero_documento , 
				tpc.n_tipo_documento ,  
				dce_tip_doc.c_codigo c_tipo_documento,
				tpc.c_correo_electronico,
				tpc.c_telefono,
				TO_CHAR(dsp.d_hora_ingreso, 'HH24:MI') AS d_hora_ingreso,
				TO_CHAR(dsp.d_hora_salida, 'HH24:MI') AS d_hora_salida,
				dsp.c_oficina,
				TO_CHAR(tc.d_fecha_inicio_contrato, 'DD/MM/YYYY')d_fecha_inicio_contrato,
				TO_CHAR(tc.d_fecha_fin_contrato, 'DD/MM/YYYY')d_fecha_fin_contrato,
				tc.n_tipo_proceso_contrato,
				tc.c_tipo_proceso_contrato,
				cs.c_correlativo,
				tc.c_numero_contrato, 
				tc.c_nombre_contrato, 
				--tc.c_motivo_proceso_contrato,
				tc.c_ruc, 
				tc.c_razon_social, 
				tc.n_tipo_empresa, 
				tc.c_tipo_empresa,
				dsp.n_sede n_cod_sede_acceso, 
				dce4.c_nombre c_sede_acceso	,
				muo.n_gerencia n_gerencia_acceso,
            	COALESCE(muo.c_gerencia, 'SIN INFORMACIÓN')c_gerencia_acceso,
				muo.n_subgerencia n_subgerencia_acceso,
				COALESCE(muo.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia_acceso,
				tc.n_proceso_electoral, 
				tc.c_tipo_proceso_electoral,
				dpc.n_det_personal_contrato_pk
		from cab_solicitud cs 
		INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = cs.n_tipo_solicitud AND dce1.c_columna = 'N_TIPO_SOLICITUD' --and dce1.n_activo=1
		INNER JOIN tab_solicitud_evaluacion tse on tse.n_solicitud =  cs.n_solicitud_pk and tse.n_activo=1
		inner join det_catalogo_estructura dce8 ON dce8.n_codigo = tse.n_estado_solicitud AND dce8.c_columna = 'N_ESTADO_SOLICITUD' --and dce8.n_activo=1
		inner join det_solicitud_contrato dsc on dsc.n_solicitud = cs.n_solicitud_pk and dsc.n_activo=1	
		inner  join (select tc.n_contrato_pk ,tc.n_tipo_contrato, dce1.c_nombre c_tipo_contrato , tc.n_sede ,dce14.c_nombre c_sede, tc.n_unidad_organica, tc.d_fecha_inicio_contrato,
							tc.d_fecha_fin_contrato, tc.c_oficina, tc.n_tipo_proceso_contrato, dce15.c_nombre c_tipo_proceso_contrato,tc.c_numero_contrato, tc.c_nombre_contrato, 
							--tc.c_motivo_proceso_contrato,
							tc.n_proceso_electoral, tpe.c_acronimo c_tipo_proceso_electoral,
							mep.c_ruc, mep.c_razon_social, mep.n_tipo_empresa, dce16.c_nombre c_tipo_empresa,muo.n_gerencia, muo.c_gerencia,	muo.n_subgerencia,	muo.c_subgerencia
					from tab_contrato tc 
					inner join det_catalogo_estructura dce1 ON dce1.n_codigo = tc.n_tipo_contrato AND dce1.c_columna = 'N_TIPO_CONTRATO' --and dce1.n_activo=1
					INNER JOIN det_catalogo_estructura dce14 ON dce14.n_codigo = tc.n_sede AND dce14.c_columna = 'N_SEDE' and dce14.n_activo=1
					INNER JOIN det_catalogo_estructura dce15 ON dce15.n_codigo = tc.n_tipo_proceso_contrato AND dce15.c_columna = 'N_TIPO_PROCESO_CONTRATO' --and dce15.n_activo=1
					left join mae_empresa_proveedor mep on mep.n_empresa_proveedor_pk = tc.n_empresa_proveedor
					left JOIN det_catalogo_estructura dce16 ON dce16.n_codigo = mep.n_tipo_empresa AND dce16.c_columna = 'N_TIPO_EMPRESA' --and dce16.n_activo=1
					LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
									CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
									CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
									CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
		    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
								FROM mae_unidad_organica uo
								LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk --and uo_padre.n_activo =1
								--where uo.n_activo = 1 
								) muo ON muo.n_unidad_organica_pk = tc.n_unidad_organica 
					left join tab_proceso_electoral tpe on tpe.n_proceso_electoral_pk = tc.n_proceso_electoral		
					where tc.n_activo=1 
					) tc on tc.n_contrato_pk = dsc.n_contrato 				
		inner join det_personal_contrato dpc on dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1	
		inner join tab_personal_servicio tpc on tpc.n_personal_servicio_pk = dpc.n_personal_servicio 
		inner join det_catalogo_estructura dce_tip_doc ON dce_tip_doc.n_codigo = tpc.n_tipo_documento AND dce_tip_doc.c_columna = 'N_TIPO_DOCUMENTO' --and dce_tip_doc.n_activo=1	
		inner join det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and dsp.n_activo=1
		inner JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = dsp.n_sede AND dce4.c_columna = 'N_SEDE' and dce4.n_activo=1
		inner join det_catalogo_estructura dce5 ON dce5.n_codigo = dsp.n_estado_solicitud_detalle AND dce5.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' --and dce5.n_activo=1
		inner JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
					) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
		where cs.n_activo=1 and cs.n_tipo_solicitud in (1,2) 
		) a10 
		 WHERE (fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_aud_fecha_creacion, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)		
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (tipoSolicitud IS NULL OR a10.n_tipo_solicitud = tipoSolicitud)
		  AND (estadoSolicitud IS NULL OR a10.n_estado_solicitud = estadoSolicitud)
		  AND (estadoVigencia IS NULL OR a10.n_vigente = estadoVigencia)
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  ORDER BY n_solicitud_pk desc, TO_DATE(a10.d_fecha_inicio_acceso, 'DD/MM/YYYY') DESC;
	END;
	$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_solicitud_persona_detalle_cabecera" id="b9e6fec4-7cd8-45a5-8fde-c5bd3d65f04f" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_solicitud_persona_detalle_cabecera(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tiposolicitud integer DEFAULT NULL::integer, estadosolicitud integer DEFAULT NULL::integer, estadovigencia integer DEFAULT NULL::integer, busquedapersona text DEFAULT NULL::text)
 RETURNS TABLE(n_solicitud_persona_detalle_pk integer, n_solicitud_pk integer, n_cod_sede integer, c_sede character varying, d_fecha_inicio_acceso text, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_tipo_solicitud integer, c_tipo_solicitud character varying, n_vigente integer, c_vigente text, n_estado_solicitud integer, c_estado_solicitud character varying, d_aud_fecha_creacion text, c_nombres_apellidos text, c_numero_documento character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
select * from (
		select  ROW_NUMBER() OVER ()::INTEGER AS n_solicitud_persona_detalle_pk, --si va
				cs.n_solicitud_pk,	 
				tc.n_sede n_cod_sede, 
				tc.c_sede,			
				TO_CHAR(dsp.d_fecha_inicio_acceso, 'DD/MM/YYYY')d_fecha_inicio_acceso, 
				--TO_CHAR(dsp.d_fecha_fin_acceso, 'DD/MM/YYYY')d_fecha_fin_acceso,				
				--dsp.n_estado_solicitud_detalle,
				--dce5.c_nombre c_estado_solicitud_detalle,				
				tc.n_gerencia, 
            	COALESCE(tc.c_gerencia, 'SIN INFORMACIÓN')c_gerencia,
				tc.n_subgerencia,
				COALESCE(tc.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia,
				cs.n_tipo_solicitud, 
				dce1.c_nombre c_tipo_solicitud, 
				--tc.n_tipo_contrato,
				--tc.c_tipo_contrato ,
				dsp.n_vigente::integer, 
				case when dsp.n_vigente= 1 then 'Vigente' else 'No Vigente' end c_vigente,	
				tse.n_estado_solicitud, 
				dce8.c_nombre c_estado_solicitud, 
				TO_CHAR(cs.d_aud_fecha_creacion, 'DD/MM/YYYY')d_aud_fecha_creacion,	
				CONCAT(COALESCE(tpc.c_nombres, ''), ' ', COALESCE(tpc.c_apellido_paterno,''),' ', COALESCE(tpc.c_apellido_materno, '')) AS c_nombres_apellidos, 
				tpc.c_numero_documento  
				--tpc.n_tipo_documento ,  
				--dce_tip_doc.c_codigo c_tipo_documento,
				--tpc.c_correo_electronico,
				--tpc.c_telefono,
				--TO_CHAR(dsp.d_hora_ingreso, 'HH24:MI') AS d_hora_ingreso,
				--TO_CHAR(dsp.d_hora_salida, 'HH24:MI') AS d_hora_salida,
				--dsp.c_oficina,
				--TO_CHAR(tc.d_fecha_inicio_contrato, 'DD/MM/YYYY')d_fecha_inicio_contrato,
				--TO_CHAR(tc.d_fecha_fin_contrato, 'DD/MM/YYYY')d_fecha_fin_contrato,
				--tc.n_tipo_proceso_contrato,
				--tc.c_tipo_proceso_contrato,
				--cs.c_correlativo,
				--tc.c_numero_contrato, 
				--tc.c_nombre_contrato, 
				--tc.c_motivo_proceso_contrato,
				--tc.c_ruc, 
				--tc.c_razon_social, 
				--tc.n_tipo_empresa, 
				--tc.c_tipo_empresa,
				--dsp.n_sede n_cod_sede_acceso, 
				--dce4.c_nombre c_sede_acceso	, 
				--muo.n_gerencia n_gerencia_acceso, 
            	--COALESCE(muo.c_gerencia, 'SIN INFORMACIÓN')c_gerencia_acceso, 
				--muo.n_subgerencia n_subgerencia_acceso, 
				--COALESCE(muo.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia_acceso, 
				--tc.n_proceso_electoral, 
				--tc.c_tipo_proceso_electoral,
				--dpc.n_det_personal_contrato_pk
		from cab_solicitud cs --si
		INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = cs.n_tipo_solicitud AND dce1.c_columna = 'N_TIPO_SOLICITUD' --and dce1.n_activo=1
		INNER JOIN tab_solicitud_evaluacion tse on tse.n_solicitud =  cs.n_solicitud_pk and tse.n_activo=1 
		inner join det_catalogo_estructura dce8 ON dce8.n_codigo = tse.n_estado_solicitud AND dce8.c_columna = 'N_ESTADO_SOLICITUD' --and dce8.n_activo=1 
		inner join det_solicitud_contrato dsc on dsc.n_solicitud = cs.n_solicitud_pk and dsc.n_activo=1		
		inner  join (select tc.n_contrato_pk ,tc.n_tipo_contrato, 
							--dce1.c_nombre c_tipo_contrato , 
							tc.n_sede ,dce14.c_nombre c_sede, tc.n_unidad_organica, tc.d_fecha_inicio_contrato,
							tc.d_fecha_fin_contrato, tc.c_oficina, tc.n_tipo_proceso_contrato, 
							--dce15.c_nombre c_tipo_proceso_contrato,
							tc.c_numero_contrato, tc.c_nombre_contrato, 
							tc.n_proceso_electoral, tpe.c_acronimo c_tipo_proceso_electoral,
							--mep.c_ruc, mep.c_razon_social, mep.n_tipo_empresa, dce16.c_nombre c_tipo_empresa,
							muo.n_gerencia, muo.c_gerencia,	muo.n_subgerencia,	muo.c_subgerencia
					from tab_contrato tc 
					--inner join det_catalogo_estructura dce1 ON dce1.n_codigo = tc.n_tipo_contrato AND dce1.c_columna = 'N_TIPO_CONTRATO' --and dce1.n_activo=1
					INNER JOIN det_catalogo_estructura dce14 ON dce14.n_codigo = tc.n_sede AND dce14.c_columna = 'N_SEDE' --and dce14.n_activo=1
					--INNER JOIN det_catalogo_estructura dce15 ON dce15.n_codigo = tc.n_tipo_proceso_contrato AND dce15.c_columna = 'N_TIPO_PROCESO_CONTRATO' --and dce15.n_activo=1
					--left join mae_empresa_proveedor mep on mep.n_empresa_proveedor_pk = tc.n_empresa_proveedor
					--left JOIN det_catalogo_estructura dce16 ON dce16.n_codigo = mep.n_tipo_empresa AND dce16.c_columna = 'N_TIPO_EMPRESA' --and dce16.n_activo=1
					LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
									CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
									CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
									CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
		    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
							FROM mae_unidad_organica uo
							LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
							where uo.n_activo = 1 
								) muo ON muo.n_unidad_organica_pk = tc.n_unidad_organica 
					left join tab_proceso_electoral tpe on tpe.n_proceso_electoral_pk = tc.n_proceso_electoral		
					where tc.n_activo=1 
					) tc on tc.n_contrato_pk = dsc.n_contrato 	
		left join det_personal_contrato dpc on dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1	
		left join tab_personal_servicio tpc on tpc.n_personal_servicio_pk = dpc.n_personal_servicio 
		--left join det_catalogo_estructura dce_tip_doc ON dce_tip_doc.n_codigo = tpc.n_tipo_documento AND dce_tip_doc.c_columna = 'N_TIPO_DOCUMENTO' --and dce_tip_doc.n_activo=1	
		left join det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and dsp.n_activo=1 
		--left JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = dsp.n_sede AND dce4.c_columna = 'N_SEDE' and dce4.n_activo=1
		--left join det_catalogo_estructura dce5 ON dce5.n_codigo = dsp.n_estado_solicitud_detalle AND dce5.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' --and dce5.n_activo=1
		/*
		LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
				    ) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
		*/
		where cs.n_activo=1 and cs.n_tipo_solicitud in (1,2) 
		) a10  --2762
		 WHERE 
			(fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_aud_fecha_creacion, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)		
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (tipoSolicitud IS NULL OR a10.n_tipo_solicitud = tipoSolicitud)		  
		  AND
		 (estadoSolicitud IS NULL OR a10.n_estado_solicitud = estadoSolicitud)
		  AND (estadoVigencia IS NULL OR a10.n_vigente = estadoVigencia)
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  ORDER BY n_solicitud_pk desc  , TO_DATE(a10.d_fecha_inicio_acceso, 'DD/MM/YYYY') DESC
;
	END;
	$function$
 ;]]></string>
		</function>
		<function name="fn_monitoreo_solicitud_persona_detalle_cabecera3" id="b3178270-a23e-4751-82b0-1b21fff65fd7" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION sigap_anthony.fn_monitoreo_solicitud_persona_detalle_cabecera3(pi_esquema character varying, fechainicio date DEFAULT NULL::date, fechafin date DEFAULT NULL::date, gerencia integer DEFAULT NULL::integer, subgerencia integer DEFAULT NULL::integer, sede integer DEFAULT NULL::integer, tiposolicitud integer DEFAULT NULL::integer, estadosolicitud integer DEFAULT NULL::integer, estadovigencia integer DEFAULT NULL::integer, busquedapersona text DEFAULT NULL::text)
 RETURNS TABLE(n_solicitud_persona_detalle_pk integer, n_solicitud_pk integer, n_cod_sede integer, c_sede character varying, d_fecha_inicio_acceso text, d_fecha_fin_acceso text, n_estado_solicitud_detalle integer, c_estado_solicitud_detalle character varying, n_gerencia integer, c_gerencia character varying, n_subgerencia integer, c_subgerencia character varying, n_tipo_solicitud integer, c_tipo_solicitud character varying, n_tipo_contrato integer, c_tipo_contrato character varying, n_vigente integer, c_vigente text, n_estado_solicitud integer, c_estado_solicitud character varying, d_aud_fecha_creacion text, c_nombres_apellidos text, c_numero_documento character varying, n_tipo_documento integer, c_tipo_documento character varying, c_correo_electronico character varying, c_telefono character varying, d_hora_ingreso text, d_hora_salida text, c_oficina character varying, d_fecha_inicio_contrato text, d_fecha_fin_contrato text, n_tipo_proceso_contrato integer, c_tipo_proceso_contrato character varying, c_correlativo character varying, c_numero_contrato character varying, c_nombre_contrato character varying, c_ruc character varying, c_razon_social character varying, n_tipo_empresa integer, c_tipo_empresa character varying, n_cod_sede_acceso integer, c_sede_acceso character varying, n_gerencia_acceso integer, c_gerencia_acceso character varying, n_subgerencia_acceso integer, c_subgerencia_acceso character varying, n_proceso_electoral integer, c_tipo_proceso_electoral character varying, n_det_personal_contrato_pk integer)
 LANGUAGE plpgsql
AS $function$
BEGIN
    EXECUTE 'SET search_path =' || pi_esquema; 
    RETURN QUERY
select * from (
		select  ROW_NUMBER() OVER ()::INTEGER AS n_solicitud_persona_detalle_pk,
				cs.n_solicitud_pk,			
				tc.n_sede n_cod_sede, 
				tc.c_sede,			
				TO_CHAR(dsp.d_fecha_inicio_acceso, 'DD/MM/YYYY')d_fecha_inicio_acceso,
				TO_CHAR(dsp.d_fecha_fin_acceso, 'DD/MM/YYYY')d_fecha_fin_acceso,				
				dsp.n_estado_solicitud_detalle,
				dce5.c_nombre c_estado_solicitud_detalle,				
				tc.n_gerencia,
            	COALESCE(tc.c_gerencia, 'SIN INFORMACIÓN')c_gerencia,
				tc.n_subgerencia,
				COALESCE(tc.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia,
				cs.n_tipo_solicitud, 
				dce1.c_nombre c_tipo_solicitud,
				tc.n_tipo_contrato,
				tc.c_tipo_contrato ,
				dsp.n_vigente::integer,
				case when dsp.n_vigente= 1 then 'Vigente' else 'No Vigente' end c_vigente,
				tse.n_estado_solicitud,
				dce8.c_nombre c_estado_solicitud
				,TO_CHAR(cs.d_aud_fecha_creacion, 'DD/MM/YYYY')d_aud_fecha_creacion,				
				CONCAT(COALESCE(tpc.c_nombres, ''), ' ', COALESCE(tpc.c_apellido_paterno,''),' ', COALESCE(tpc.c_apellido_materno, '')) AS c_nombres_apellidos, 
				tpc.c_numero_documento , 
				tpc.n_tipo_documento ,  
				dce_tip_doc.c_codigo c_tipo_documento,
				tpc.c_correo_electronico,
				tpc.c_telefono,
				TO_CHAR(dsp.d_hora_ingreso, 'HH24:MI') AS d_hora_ingreso,
				TO_CHAR(dsp.d_hora_salida, 'HH24:MI') AS d_hora_salida,
				dsp.c_oficina,
				TO_CHAR(tc.d_fecha_inicio_contrato, 'DD/MM/YYYY')d_fecha_inicio_contrato,
				TO_CHAR(tc.d_fecha_fin_contrato, 'DD/MM/YYYY')d_fecha_fin_contrato,
				tc.n_tipo_proceso_contrato,
				tc.c_tipo_proceso_contrato,
				cs.c_correlativo,
				tc.c_numero_contrato, 
				tc.c_nombre_contrato, 
				--tc.c_motivo_proceso_contrato,
				tc.c_ruc, 
				tc.c_razon_social, 
				tc.n_tipo_empresa, 
				tc.c_tipo_empresa,
				dsp.n_sede n_cod_sede_acceso, 
				dce4.c_nombre c_sede_acceso	,
				muo.n_gerencia n_gerencia_acceso,
            	COALESCE(muo.c_gerencia, 'SIN INFORMACIÓN')c_gerencia_acceso,
				muo.n_subgerencia n_subgerencia_acceso,
				COALESCE(muo.c_subgerencia, 'SIN INFORMACIÓN')c_subgerencia_acceso,
				tc.n_proceso_electoral, 
				tc.c_tipo_proceso_electoral,
				dpc.n_det_personal_contrato_pk
		from cab_solicitud cs 
		INNER JOIN det_catalogo_estructura dce1 ON dce1.n_codigo = cs.n_tipo_solicitud AND dce1.c_columna = 'N_TIPO_SOLICITUD' --and dce1.n_activo=1
		INNER JOIN tab_solicitud_evaluacion tse on tse.n_solicitud =  cs.n_solicitud_pk and tse.n_activo=1
		inner join det_catalogo_estructura dce8 ON dce8.n_codigo = tse.n_estado_solicitud AND dce8.c_columna = 'N_ESTADO_SOLICITUD' --and dce8.n_activo=1
		inner join det_solicitud_contrato dsc on dsc.n_solicitud = cs.n_solicitud_pk and dsc.n_activo=1		
		inner  join (select tc.n_contrato_pk ,tc.n_tipo_contrato, dce1.c_nombre c_tipo_contrato , tc.n_sede ,dce14.c_nombre c_sede, tc.n_unidad_organica, tc.d_fecha_inicio_contrato,
							tc.d_fecha_fin_contrato, tc.c_oficina, tc.n_tipo_proceso_contrato, dce15.c_nombre c_tipo_proceso_contrato,tc.c_numero_contrato, tc.c_nombre_contrato, 
							--tc.c_motivo_proceso_contrato,
							tc.n_proceso_electoral, tpe.c_acronimo c_tipo_proceso_electoral,
							mep.c_ruc, mep.c_razon_social, mep.n_tipo_empresa, dce16.c_nombre c_tipo_empresa,muo.n_gerencia, muo.c_gerencia,	muo.n_subgerencia,	muo.c_subgerencia
					from tab_contrato tc 
					inner join det_catalogo_estructura dce1 ON dce1.n_codigo = tc.n_tipo_contrato AND dce1.c_columna = 'N_TIPO_CONTRATO' --and dce1.n_activo=1
					INNER JOIN det_catalogo_estructura dce14 ON dce14.n_codigo = tc.n_sede AND dce14.c_columna = 'N_SEDE' --and dce14.n_activo=1
					INNER JOIN det_catalogo_estructura dce15 ON dce15.n_codigo = tc.n_tipo_proceso_contrato AND dce15.c_columna = 'N_TIPO_PROCESO_CONTRATO' --and dce15.n_activo=1
					left join mae_empresa_proveedor mep on mep.n_empresa_proveedor_pk = tc.n_empresa_proveedor
					left JOIN det_catalogo_estructura dce16 ON dce16.n_codigo = mep.n_tipo_empresa AND dce16.c_columna = 'N_TIPO_EMPRESA' --and dce16.n_activo=1
					LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
									CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
									CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
									CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
		    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
							FROM mae_unidad_organica uo
							LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
							where uo.n_activo = 1 
								) muo ON muo.n_unidad_organica_pk = tc.n_unidad_organica 
					left join tab_proceso_electoral tpe on tpe.n_proceso_electoral_pk = tc.n_proceso_electoral		
					where tc.n_activo=1 
					) tc on tc.n_contrato_pk = dsc.n_contrato 				
		left join det_personal_contrato dpc on dpc.n_det_solicitud_contrato = dsc.n_det_solicitud_contrato_pk and dpc.n_activo=1	
		left join tab_personal_servicio tpc on tpc.n_personal_servicio_pk = dpc.n_personal_servicio 
		left join det_catalogo_estructura dce_tip_doc ON dce_tip_doc.n_codigo = tpc.n_tipo_documento AND dce_tip_doc.c_columna = 'N_TIPO_DOCUMENTO' --and dce_tip_doc.n_activo=1	
		left join det_solicitud_personal dsp on dsp.n_det_personal_contrato = dpc.n_det_personal_contrato_pk and dsp.n_activo=1
		left JOIN det_catalogo_estructura dce4 ON dce4.n_codigo = dsp.n_sede AND dce4.c_columna = 'N_SEDE' and dce4.n_activo=1
		left join det_catalogo_estructura dce5 ON dce5.n_codigo = dsp.n_estado_solicitud_detalle AND dce5.c_columna = 'N_ESTADO_SOLICITUD_DETALLE' --and dce5.n_activo=1
		LEFT JOIN (SELECT uo.n_unidad_organica_pk, 
							CASE WHEN uo.n_nivel = 1 THEN uo.n_unidad_organica_pk  ELSE uo_padre.n_unidad_organica_pk  END AS n_gerencia, 
							CASE WHEN uo.n_nivel = 1 THEN uo.c_siglas  ELSE uo_padre.c_siglas  END AS c_gerencia,
							CASE WHEN uo.n_nivel = 2 THEN uo.n_unidad_organica_pk  ELSE uo.n_unidad_organica_pk   END AS n_subgerencia ,
    						CASE WHEN uo.n_nivel = 2 THEN uo.c_siglas  ELSE uo.c_siglas   END AS c_subgerencia 
					FROM mae_unidad_organica uo
					LEFT JOIN mae_unidad_organica uo_padre ON uo.n_padre = uo_padre.n_unidad_organica_pk and uo_padre.n_activo =1
					where uo.n_activo = 1 
				    ) muo ON muo.n_unidad_organica_pk = dsp.n_unidad_organica 
		where cs.n_activo=1 and cs.n_tipo_solicitud in (1,2) 
		) a10 
		 WHERE 
			(fechaInicio IS NULL OR fechaFin IS NULL OR (TO_DATE(a10.d_aud_fecha_creacion, 'DD/MM/YYYY') BETWEEN fechaInicio AND fechaFin))  
		  AND (gerencia IS NULL OR a10.n_gerencia = gerencia)
		  AND (subGerencia IS NULL OR a10.n_subgerencia = subGerencia)		
		  AND (sede IS NULL OR a10.n_cod_sede = sede)
		  AND (tipoSolicitud IS NULL OR a10.n_tipo_solicitud = tipoSolicitud)		  
		  AND
		 (estadoSolicitud IS NULL OR a10.n_estado_solicitud = estadoSolicitud)
		  AND (estadoVigencia IS NULL OR a10.n_vigente = estadoVigencia)
		  AND (
			    busquedaPersona IS NULL 
			    OR a10.c_nombres_apellidos ILIKE '%' || busquedaPersona || '%'
			    OR a10.c_numero_documento ILIKE '%' || busquedaPersona || '%'
			)
		  ORDER BY n_solicitud_pk desc  , TO_DATE(a10.d_fecha_inicio_acceso, 'DD/MM/YYYY') DESC
;
	END;
	$function$
 ;]]></string>
		</function>
		<trigger name="trg_incrementar_secuencia_solicitud_equipo_vehiculo" table="cab_solicitud_equipo_vehiculo" id="92ce01df-125f-4c1c-b62c-bf78d69201bd" isSystem="false" >
			<string><![CDATA[CREATE TRIGGER trg_incrementar_secuencia_solicitud_equipo_vehiculo BEFORE INSERT ON sigap_anthony.cab_solicitud_equipo_vehiculo FOR EACH ROW EXECUTE FUNCTION sigap_anthony.fn_incrementar_secuencia_anual()]]></string>
		</trigger>
		<trigger name="trg_incrementar_secuencia_solicitud_personal" table="cab_solicitud" id="f93bd88c-8503-4c8d-96c9-f155f3bfb2e6" isSystem="false" >
			<string><![CDATA[CREATE TRIGGER trg_incrementar_secuencia_solicitud_personal BEFORE INSERT ON sigap_anthony.cab_solicitud FOR EACH ROW EXECUTE FUNCTION sigap_anthony.fn_incrementar_secuencia_anual()]]></string>
		</trigger>
	</schema>
